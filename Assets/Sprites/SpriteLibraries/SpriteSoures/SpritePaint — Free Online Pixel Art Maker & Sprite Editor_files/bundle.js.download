","project.recover":"Open recovered copy","project.restoreDamaged":"Your browser save contains damaged data. It has not been replaced. Download a recovered copy to inspect the changes listed below.","storage.loadTitle":"Unable to open browser storage","storage.loadMessage":"Part of SpritePaint could not load. Retry opening the editor. Editing is paused to protect your saved work.","storage.saveFailed":"Changes are not being saved in this browser. Download a project copy before closing.","storage.downloadFailed":"The project copy could not be downloaded. Keep this tab open and try again.","storage.downloadCopy":"Download project copy","storage.retrySave":"Retry saving","storage.retryOpen":"Retry opening","storage.migrationTitle":"Your project opened, but could not be saved","storage.migrationMessage":"Your existing saved copy has not been replaced. Editing is paused. Download a project copy, or free browser storage and retry.","session.waitTitle":"Project open in another tab","session.waitMessage":"Close the other editor tab to continue here. This tab will automatically load your latest saved work.","session.errorTitle":"Unable to open the editor safely","session.errorMessage":"This browser could not coordinate your project tabs. Reload in an up-to-date browser using HTTPS.","session.restoreTitle":"Unable to restore your project","session.restoreMessage":"The editor could not load your saved project. Try reloading this tab. Editing is paused to protect your saved work.","tool.pencil":"Pencil","tool.eraser":"Eraser","tool.line":"Line","tool.circle":"Circle","tool.square":"Square","tool.fill":"Fill","tool.eye-dropper":"Eye Dropper","tool.move":"Move","tool.lasso":"Freeform Lasso","selection.move":"Move Selection","selection.scale":"Scale Selection","selection.rotate":"Rotate Selection","selection.clear":"Clear Selection","canvas.noLassoEmpty":"No Lasso on an empty frame. Disable to start drawing.","canvas.layerHidden":"Layer is hidden.","canvas.groupMoveEmpty":"Move the playhead to a frame with artwork in this group.","canvas.groupHidden":"Group is hidden. Show it and its parent groups to edit.","canvas.groupSelected":"Use Move to move the whole group. Select a layer to use other tools.","canvas.groupLasso":"Select a layer inside this group to use the lasso. Turn off lasso to move the whole group.","canvas.noMoveEmpty":"No Move tool on an empty frame.","canvas.noEyeDropperEmpty":"No Eye dropper tool on an empty frame.","toolbar.smoothStabilizer":"Smooth Stabilizer","header.brushSize":"Brush Size","header.copy":"Copy","header.paste":"Paste","header.undo":"Undo","header.redo":"Redo","header.grid":"Grid","header.mirrorX":"Mirror X","header.mirrorY":"Mirror Y","header.pixelPerfect":"Pixel Perfect (1px pencil, mirror off)","header.shapeFilled":"Shape Filled","header.fillModeConnected":"Connected","header.fillModeAllMatching":"All Matching","header.fillModeConnectedTitle":"Fill connected pixels only (contiguous)","header.fillModeAllMatchingTitle":"Fill all matching pixels","header.new":"New Project","header.download":"Download / Export","header.resizeCanvas":"Resize Canvas","header.shareAnimation":"Share Project","header.saveProject":"Save Project","import.title":"Import Image","import.choose":"Choose…","import.crop":"Crop","import.expand":"Expand canvas","import.expandLimit":"Expand canvas (max 500 px)","import.fit":"Scale to fit","import.smooth":"Smooth scaling","import.hidden":"Target group is hidden.","import.loading":"Loading…","import.image":"Image","import.scale":"Scale","import.preview":"Imported image preview","import.confirm":"Import","import.limit":"Canvas size is limited to 500 × 500 pixels.","import.layerLimit":"The project already has 30 layers. Remove a layer before importing.","import.depthLimit":"This group is nested too deeply. Select a parent group before importing.","import.unavailable":"Stop playback and use the active editing tab to import.","import.formatError":"Choose a PNG, JPEG, GIF, WebP or BMP image.","import.fileLimit":"Choose an image smaller than 25 MB.","import.pixelLimit":"Choose an image with no more than 16 million pixels.","import.readError":"This image could not be opened. Try another image.","import.anchor.top-left":"Top left","import.anchor.top-center":"Top center","import.anchor.top-right":"Top right","import.anchor.middle-left":"Middle left","import.anchor.center":"Center","import.anchor.middle-right":"Middle right","import.anchor.bottom-left":"Bottom left","import.anchor.bottom-center":"Bottom center","import.anchor.bottom-right":"Bottom right","header.loadProject":"Open Project","header.discord":"Discord","header.tutorials":"Tutorials","header.feedback":"Feedback","header.error.tooLarge":"Project is too large to share via URL. Try reducing frames, layers, or canvas size.","header.error.noCompression":"Your browser does not support compression. Try a modern browser.","header.error.shareFailed":"Failed to generate share URL.","header.error.loadFailed":"Failed to load project file.","timeline.insertFrame":"Insert Frame","timeline.moveFrameBackward":"Move Frame Backward","timeline.moveFrameForward":"Move Frame Forward","timeline.trimFrameLength":"Trim Frame Length","timeline.extendFrameLength":"Extend Frame Length","timeline.deleteFrame":"Delete Frame","timeline.splitClip":"Split Clip","timeline.onionSkin":"Onion Skin","timeline.lastFrame":"Last Frame","timeline.playAnimation":"Play Animation","timeline.nextFrame":"Next Frame","timeline.currentFrame":"Current frame","timeline.framesPerSecond":"Frames Per Second","timeline.fps":"FPS","timeline.addLayer":"Add Layer","timeline.cloneLayer":"Clone Layer","timeline.moveLayerUp":"Move Layer Up","timeline.moveLayerDown":"Move Layer Down","timeline.deleteLayer":"Delete Layer","color.title":"Color","color.hsl":"HSL","color.rgb":"RGB","color.current":"Current Color","color.previous":"Previous Color","color.restorePrevious":"Restore Previous Color","color.addColor":"Add Color","color.deleteColor":"Delete Color","color.newPalette":"New Palette","color.deletePalette":"Delete Palette","color.confirmDeletePalette":"Are you sure you want to delete this palette?","dialog.newCanvas":"New Canvas","dialog.presets":"Presets","dialog.width":"Width","dialog.height":"Height","dialog.cancel":"Cancel","dialog.confirm":"Confirm","dialog.download":"Download","dialog.type":"Type","dialog.gif":"GIF","dialog.frame":"Frame","dialog.spritesheet":"Spritesheet","dialog.size":"Size","dialog.exporting":"Exporting...","dialog.saveProject":"Save Project","dialog.fileName":"File Name","dialog.renameLayer":"Rename Layer","dialog.renameGroup":"Rename Group","dialog.name":"Name","dialog.saving":"Saving...","dialog.saveError":"Failed to save project.","dialog.shareAnimation":"Share Project","dialog.generatingLink":"Generating share link...","dialog.shareInstruction":"Copy this URL to share your project, including hidden layers. Anyone with the link can open a copy.","dialog.close":"Close","dialog.copyToClipboard":"Copy to Clipboard","dialog.copied":"Copied!","dialog.resizeCanvas":"Resize Canvas","dialog.resizeContents":"Resize contents","dialog.anchor":"Anchor","history.title":"History","dialog.versionUpgrade":"Version Upgrade Notice","shared.viewingMessage":"You are viewing a shared project. No changes will be saved.","shared.backToProject":"Back to My Project","app.leaveConfirm":"Are you sure you want to leave?","migrate.updateAlert":"New SpritePaint Update Alert! New features include:","migrate.lasso":"Introduced a basic Lasso tool","migrate.mirror":"Mirror setting to pencil: Horizontal and Vertical","migrate.filledShapes":"Added filled shapes to square and circle","migrate.copyPaste":"Copy and Paste drawing selections within the frame or across frames","migrate.canvasResize":"Make a canvas of any size and resize it mid project","migrate.pan":"Pan artboard by holding down spacebar","migrate.extendTrim":"Extend and Trim the frame length of your drawings","migrate.onionSkin":"Control the frame length of your onion skins","migrate.fps":"Edit and persist the control of your fps","migrate.grid":"Enable and disable a basic grid","migrate.palettes":"Save, edit, and delete color palettes","dialog.whatsNew":"What's New","announce.intro":"SpritePaint has been updated since your last visit. New features include:","announce.contact":"Questions or feedback? Email","feedback.title":"Feedback","feedback.body":"Have a question, found a bug, or want a feature? The feedback form is the fastest way to reach us — everything you send there goes straight to the team.","feedback.openForm":"Open feedback form","feedback.orEmail":"Prefer email? Write to","announce.clipMove":"Drag drawings along the timeline to move them","announce.clipTrim":"Drag either edge of a drawing in the timeline to extend or trim it","announce.layerGroups":"Organize layers into nested groups. Move, resize, and rotate grouped artwork together, or shift its timing on the timeline.","announce.toolControls":"Tool controls now follow your selected tool, keeping the options you need close at hand.","announce.mp4":"Download animations as MP4 video, with export progress and cancellation in supported browsers.","announce.projectProtection":"New save-failure alerts, recovery options, and protection against conflicting edits in multiple tabs.","announce.importImage":"Add an image as a new layer from the Import Image menu option. Crop it, scale it to fit, or expand your canvas. Undo the import in one step.","export.output":"Output:","export.perFrame":"per frame","export.padded":"Padded to even dimensions for MP4.","export.tooLarge":"This size is too large for your browser. Choose a smaller size.","export.frames":"frames","export.starting":"Starting…","export.rendering":"Rendering","export.finalizing":"Finalizing…","landing.title":"SpritePaint — Free Online Pixel Art Maker & Sprite Editor","landing.metaDescription":"Free online pixel art maker and animation tool. Draw sprites, animate frame by frame, and export sprite sheets, GIFs, and PNGs. No download required.","landing.ogDescription":"Free online pixel art maker and animation tool. Draw sprites, animate frame by frame, and export sprite sheets, GIFs, and PNGs.","landing.startDrawing":"Start Drawing","landing.heroTitle":"Online <span>Pixel Art</span> Maker & Sprite Editor","landing.heroSubtitle":"Draw sprites, animate them frame by frame, and export PNGs, GIFs, or sprite sheets — right in your browser.","landing.noAccount":"No account needed","landing.featuresHeading":"Everything you need, nothing you don't","landing.drawingTools":"Drawing Tools","landing.drawingToolsDesc":"Pencil, eraser, line, circle, rectangle, fill bucket, eye dropper, and lasso selection. Adjustable brush sizes from 1 to 64 pixels. Mirror drawing on X and Y axes for symmetrical sprites.","landing.animation":"Frame-by-Frame Animation","landing.animationDesc":"Create animated sprites with up to 100 frames. Onion skinning shows previous and next frames as guides. Set custom frame rates and preview your animation in real time.","landing.layers":"Layers","landing.layersDesc":"Organize your artwork in layers and nested groups. Duplicate, reorder, rename, and show or hide layers. Each layer has its own frame clips for complex animations.","landing.export":"Export Anywhere","landing.exportDesc":"Export your work as PNG images, animated GIFs, sprite sheets, or MP4 video in supported browsers. Scale exports from 1x up to 64x. Ready for game engines like Unity, Godot, or GameMaker.","landing.palettes":"Color Palettes","landing.palettesDesc":"Built-in palettes including NES colors, plus palettes you save and edit yourself. Pick colors with RGB or HSL sliders. Eye dropper tool to sample any color on your canvas.","landing.guideHeading":"How to draw pixel art","landing.guideStep1Title":"Pick a small canvas.","landing.guideStep1Desc":"16x16 or 32x32 is a classic size for characters, items, and icons.","landing.guideStep2Title":"Draw the silhouette.","landing.guideStep2Desc":"Outline the shape with a 1-pixel pencil and a single dark color.","landing.guideStep3Title":"Block in the base colors.","landing.guideStep3Desc":"Use the fill tool and a limited palette — 4–8 colors is plenty to start.","landing.guideStep4Title":"Add light and shadow.","landing.guideStep4Desc":"Choose a light direction: use a darker shade on the shadow side and a lighter one on the lit side.","landing.guideStep5Title":"Export.","landing.guideStep5Desc":"Save a PNG at 4x or 8x so every pixel stays crisp.","landing.guideAnimationHeading":"Pixel animation","landing.guideAnimationDesc":"Add frames, turn on onion skinning, and draw the motion one step at a time. An idle animation needs only 2–4 frames; a walk cycle usually takes 4–8. Around 8–12 frames per second usually looks natural. Download the finished animation as a GIF, sprite sheet, or MP4 video.","landing.guideSchoolsHeading":"For schools and Chromebooks","landing.guideSchoolsDesc":"SpritePaint runs entirely in the browser, so it works on school computers and Chromebooks with nothing to install and no accounts.","landing.share":"Share Instantly","landing.shareDesc":"Generate a shareable link to your animation with one click. No account needed. Recipients can view and play your sprite animation directly in the browser.","landing.howItWorks":"How it works","landing.step1Title":"Pick a canvas size","landing.step1Desc":"From 2x2 up to 500x500. Common sizes: 16x16, 32x32, 64x64.","landing.step2Title":"Draw your sprite","landing.step2Desc":"Use pencil, shapes, and fill. Add layers for characters, backgrounds, and effects.","landing.step3Title":"Animate it","landing.step3Desc":"Add frames, use onion skinning, preview at any speed.","landing.step4Title":"Export & share","landing.step4Desc":"Download as PNG, GIF, or sprite sheet — or share with a link.","landing.faqHeading":"Frequently Asked Questions","landing.faq1Q":"Is SpritePaint really free?","landing.faq1A":"Yes, completely free. No hidden fees, no watermarks on exports, no account required.","landing.faq2Q":"Do I need to download anything?","landing.faq2A":"No. SpritePaint runs entirely in your browser — Chrome, Firefox, Safari, and Edge on Windows, Mac, Linux, and Chromebook.","landing.faq3Q":"What export formats are supported?","landing.faq3A":"PNG images, animated GIFs, sprite sheets, and MP4 video in supported browsers. Every export can be scaled from 1x up to 64x.","landing.faq4Q":"Can I make animated sprites?","landing.faq4A":"Yes! Up to 100 frames with onion skinning. Export as GIF or sprite sheet for game engines like Unity, Godot, or GameMaker.","landing.faq5Q":"Will my work be saved?","landing.faq5A":"Your work auto-saves to your browser. You can also save as a .spritepaint file to back up or transfer between computers.","landing.faq6Q":"What canvas sizes can I use?","landing.faq6A":"From 2x2 up to 500x500 pixels. Popular game sprite sizes: 8x8, 16x16, 32x32, 64x64. Resize anytime, and choose whether to scale your artwork to fit the new size.","landing.readyToCreate":"Ready to create?","landing.joinArtists":"Join thousands of pixel artists. Start drawing in seconds.","landing.openApp":"Open SpritePaint","landing.footer":"SpritePaint — Free Online Pixel Art Maker & Sprite Editor"},ru:{"header.pencilOnly":"Рисовать только Apple Pencil","header.touchDrawing":"Рисовать пальцем или Apple Pencil","header.drawingInput":"Способ рисования","project.recoveryTitle":"Восстановить повреждённый проект?","project.recoveryMessage":"Файл содержит повреждённые данные. Вы можете открыть восстановленную копию с изменениями, перечисленными ниже, или отменить, чтобы сохранить текущий проект. Исходный файл не будет изменён.","project.recover":"Открыть восстановленную копию","project.restoreDamaged":"Сохранение в браузере содержит повреждённые данные. Оно не было заменено. Скачайте восстановленную копию, чтобы проверить изменения, перечисленные ниже.","storage.loadTitle":"Не удалось открыть хранилище браузера","storage.loadMessage":"Часть SpritePaint не загрузилась. Попробуйте открыть редактор ещё раз. Редактирование приостановлено, чтобы защитить сохранённую работу.","storage.saveFailed":"Изменения не сохраняются в этом браузере. Скачайте копию проекта перед закрытием.","storage.downloadFailed":"Не удалось скачать копию проекта. Не закрывайте эту вкладку и попробуйте ещё раз.","storage.downloadCopy":"Скачать копию проекта","storage.retrySave":"Повторить сохранение","storage.retryOpen":"Повторить открытие","storage.migrationTitle":"Проект открыт, но его не удалось сохранить","storage.migrationMessage":"Ваша сохранённая копия не была заменена. Редактирование приостановлено. Скачайте копию проекта или освободите место в хранилище браузера и повторите попытку.","session.waitTitle":"Проект открыт в другой вкладке","session.waitMessage":"Закройте другую вкладку редактора, чтобы продолжить здесь. Эта вкладка автоматически загрузит вашу последнюю сохранённую работу.","session.errorTitle":"Не удалось безопасно открыть редактор","session.errorMessage":"Этот браузер не смог согласовать вкладки с вашим проектом. Перезагрузите страницу в актуальном браузере через HTTPS.","session.restoreTitle":"Не удалось восстановить проект","session.restoreMessage":"Редактору не удалось загрузить сохранённый проект. Попробуйте перезагрузить эту вкладку. Редактирование приостановлено, чтобы защитить сохранённую работу.","tool.pencil":"Карандаш","tool.eraser":"Ластик","tool.line":"Линия","tool.circle":"Круг","tool.square":"Квадрат","tool.fill":"Заливка","tool.eye-dropper":"Пипетка","tool.move":"Перемещение","tool.lasso":"Свободное лассо","selection.move":"Переместить выделение","selection.scale":"Масштабировать выделение","selection.rotate":"Повернуть выделение","selection.clear":"Снять выделение","canvas.noLassoEmpty":"Лассо недоступно на пустом кадре. Отключите, чтобы начать рисовать.","canvas.layerHidden":"Слой скрыт.","canvas.groupMoveEmpty":"Переместите указатель воспроизведения на кадр с рисунком в этой группе.","canvas.groupHidden":"Группа скрыта. Покажите её и родительские группы, чтобы редактировать.","canvas.groupSelected":"Используйте «Перемещение», чтобы двигать всю группу. Выберите слой, чтобы использовать другие инструменты.","canvas.groupLasso":"Выберите слой внутри этой группы, чтобы использовать лассо. Отключите лассо, чтобы перемещать всю группу.","canvas.noMoveEmpty":"Перемещение недоступно на пустом кадре.","canvas.noEyeDropperEmpty":"Пипетка недоступна на пустом кадре.","toolbar.smoothStabilizer":"Сглаживание","header.brushSize":"Размер кисти","header.copy":"Копировать","header.paste":"Вставить","header.undo":"Отменить","header.redo":"Повторить","header.grid":"Сетка","header.mirrorX":"Зеркало X","header.mirrorY":"Зеркало Y","header.pixelPerfect":"Идеальные пиксели (карандаш 1px, зеркало выкл.)","header.shapeFilled":"Заливка фигуры","header.fillModeConnected":"Связанные","header.fillModeAllMatching":"Все совпадающие","header.fillModeConnectedTitle":"Заливать только связанные пиксели (смежные)","header.fillModeAllMatchingTitle":"Заливать все совпадающие пиксели","header.new":"Новый проект","header.download":"Скачать / Экспорт","header.resizeCanvas":"Изменить размер","header.shareAnimation":"Поделиться проектом","header.saveProject":"Сохранить проект","import.title":"Импорт изображения","import.choose":"Выбрать…","import.crop":"Обрезать","import.expand":"Расширить холст","import.expandLimit":"Расширить холст (макс. 500 px)","import.fit":"Вписать в холст","import.smooth":"Плавное масштабирование","import.hidden":"Целевая группа скрыта.","import.loading":"Загрузка…","import.image":"Изображение","import.scale":"Масштаб","import.preview":"Предпросмотр импортируемого изображения","import.confirm":"Импортировать","import.limit":"Размер холста ограничен 500 × 500 пикселей.","import.layerLimit":"В проекте уже 30 слоёв. Удалите слой перед импортом.","import.depthLimit":"Эта группа вложена слишком глубоко. Выберите родительскую группу перед импортом.","import.unavailable":"Остановите воспроизведение и используйте активную вкладку редактора для импорта.","import.formatError":"Выберите изображение PNG, JPEG, GIF, WebP или BMP.","import.fileLimit":"Выберите изображение меньше 25 МБ.","import.pixelLimit":"Выберите изображение не более 16 миллионов пикселей.","import.readError":"Не удалось открыть это изображение. Попробуйте другое.","import.anchor.top-left":"Сверху слева","import.anchor.top-center":"Сверху по центру","import.anchor.top-right":"Сверху справа","import.anchor.middle-left":"Посередине слева","import.anchor.center":"По центру","import.anchor.middle-right":"Посередине справа","import.anchor.bottom-left":"Снизу слева","import.anchor.bottom-center":"Снизу по центру","import.anchor.bottom-right":"Снизу справа","header.loadProject":"Открыть проект","header.discord":"Discord","header.tutorials":"Уроки","header.feedback":"Отзыв","header.error.tooLarge":"Проект слишком большой для отправки через URL. Попробуйте уменьшить количество кадров, слоёв или размер холста.","header.error.noCompression":"Ваш браузер не поддерживает сжатие. Попробуйте современный браузер.","header.error.shareFailed":"Не удалось создать ссылку для общего доступа.","header.error.loadFailed":"Не удалось загрузить файл проекта.","timeline.insertFrame":"Вставить кадр","timeline.moveFrameBackward":"Переместить кадр назад","timeline.moveFrameForward":"Переместить кадр вперёд","timeline.trimFrameLength":"Сократить длину кадра","timeline.extendFrameLength":"Увеличить длину кадра","timeline.deleteFrame":"Удалить кадр","timeline.splitClip":"Разделить клип","timeline.onionSkin":"Калька","timeline.lastFrame":"Предыдущий кадр","timeline.playAnimation":"Воспроизвести анимацию","timeline.nextFrame":"Следующий кадр","timeline.currentFrame":"Текущий кадр","timeline.framesPerSecond":"Кадров в секунду","timeline.fps":"КДР/С","timeline.addLayer":"Добавить слой","timeline.cloneLayer":"Дублировать слой","timeline.moveLayerUp":"Переместить слой вверх","timeline.moveLayerDown":"Переместить слой вниз","timeline.deleteLayer":"Удалить слой","color.title":"Цвет","color.hsl":"HSL","color.rgb":"RGB","color.current":"Текущий цвет","color.previous":"Предыдущий цвет","color.restorePrevious":"Восстановить предыдущий цвет","color.addColor":"Добавить цвет","color.deleteColor":"Удалить цвет","color.newPalette":"Новая палитра","color.deletePalette":"Удалить палитру","color.confirmDeletePalette":"Вы уверены, что хотите удалить эту палитру?","dialog.newCanvas":"Новый холст","dialog.presets":"Шаблоны","dialog.width":"Ширина","dialog.height":"Высота","dialog.cancel":"Отмена","dialog.confirm":"Подтвердить","dialog.download":"Скачать","dialog.type":"Тип","dialog.gif":"GIF","dialog.frame":"Кадр","dialog.spritesheet":"Спрайт-лист","dialog.size":"Размер","dialog.exporting":"Экспорт...","dialog.saveProject":"Сохранить проект","dialog.fileName":"Имя файла","dialog.renameLayer":"Переименовать слой","dialog.renameGroup":"Переименовать группу","dialog.name":"Имя","dialog.saving":"Сохранение...","dialog.saveError":"Не удалось сохранить проект.","dialog.shareAnimation":"Поделиться проектом","dialog.generatingLink":"Создание ссылки...","dialog.shareInstruction":"Скопируйте эту ссылку, чтобы поделиться проектом, включая скрытые слои. Любой, у кого есть ссылка, сможет открыть его копию.","dialog.close":"Закрыть","dialog.copyToClipboard":"Скопировать ссылку","dialog.copied":"Скопировано!","dialog.resizeCanvas":"Изменить размер холста","dialog.resizeContents":"Масштабировать содержимое","dialog.anchor":"Привязка","history.title":"История","dialog.versionUpgrade":"Уведомление об обновлении","shared.viewingMessage":"Вы просматриваете общий проект. Изменения не будут сохранены.","shared.backToProject":"Вернуться к моему проекту","app.leaveConfirm":"Вы уверены, что хотите уйти?","migrate.updateAlert":"Обновление SpritePaint! Новые функции:","migrate.lasso":"Добавлен базовый инструмент «Лассо»","migrate.mirror":"Зеркальное отражение для карандаша: по горизонтали и вертикали","migrate.filledShapes":"Добавлена заливка фигур для квадрата и круга","migrate.copyPaste":"Копирование и вставка выделенных областей внутри кадра и между кадрами","migrate.canvasResize":"Создание холста любого размера и изменение размера в процессе работы","migrate.pan":"Перемещение по холсту с помощью пробела","migrate.extendTrim":"Увеличение и сокращение длины кадров","migrate.onionSkin":"Управление длиной кальки","migrate.fps":"Редактирование и сохранение настроек частоты кадров","migrate.grid":"Включение и отключение сетки","migrate.palettes":"Сохранение, редактирование и удаление цветовых палитр","dialog.whatsNew":"Что нового","announce.intro":"SpritePaint обновился с момента вашего последнего визита. Новые функции:","announce.contact":"Вопросы или отзывы? Напишите на","feedback.title":"Отзыв","feedback.body":"Есть вопрос, нашли ошибку или хотите новую функцию? Форма обратной связи — самый быстрый способ связаться с нами: всё, что вы отправите, сразу попадёт к команде.","feedback.openForm":"Открыть форму","feedback.orEmail":"Предпочитаете почту? Напишите на","announce.clipMove":"Перетаскивайте рисунки по таймлайну, чтобы переместить их","announce.clipTrim":"Перетаскивайте любой край рисунка на таймлайне, чтобы удлинить или укоротить его","announce.layerGroups":"Объединяйте слои во вложенные группы. Перемещайте, масштабируйте и вращайте рисунки вместе или сдвигайте их на таймлайне.","announce.toolControls":"Панель параметров теперь показывает настройки выбранного инструмента.","announce.mp4":"Скачивайте анимации в формате MP4 с индикатором прогресса и отменой в поддерживаемых браузерах.","announce.projectProtection":"Новые уведомления об ошибках сохранения, восстановление проектов и защита от конфликтующих правок в нескольких вкладках.","announce.importImage":"Добавляйте изображения на новый слой через пункт меню «Импорт изображения». Обрежьте изображение, уменьшите его до размеров холста или расширьте холст. Импорт можно отменить одним действием.","export.output":"Результат:","export.perFrame":"на кадр","export.padded":"Размеры дополнены до чётных для MP4.","export.tooLarge":"Этот размер слишком велик для вашего браузера. Выберите размер поменьше.","export.frames":"кадров","export.starting":"Запуск…","export.rendering":"Отрисовка","export.finalizing":"Завершение…","landing.title":"SpritePaint — Бесплатный онлайн-редактор пиксель-арта и спрайтов","landing.metaDescription":"Бесплатный онлайн-редактор пиксель-арта и инструмент для анимации. Рисуйте спрайты, создавайте покадровую анимацию, экспортируйте спрайт-листы, GIF и PNG. Без скачивания.","landing.ogDescription":"Бесплатный онлайн-редактор пиксель-арта и инструмент для анимации. Рисуйте спрайты, создавайте покадровую анимацию, экспортируйте спрайт-листы, GIF и PNG.","landing.startDrawing":"Начать рисовать","landing.heroTitle":"Онлайн-редактор <span>пиксель-арта</span> и спрайтов","landing.heroSubtitle":"Рисуйте спрайты, анимируйте их покадрово и экспортируйте в PNG, GIF или спрайт-листы — прямо в браузере.","landing.noAccount":"Без регистрации","landing.featuresHeading":"Всё необходимое и ничего лишнего","landing.drawingTools":"Инструменты рисования","landing.drawingToolsDesc":"Карандаш, ластик, линия, круг, прямоугольник, заливка, пипетка и выделение лассо. Регулируемые размеры кисти от 1 до 64 пикселей. Зеркальное рисование по осям X и Y для симметричных спрайтов.","landing.animation":"Покадровая анимация","landing.animationDesc":"Создавайте анимированные спрайты длиной до 100 кадров. Калька показывает предыдущие и следующие кадры в качестве ориентира. Настраивайте частоту кадров и просматривайте анимацию в реальном времени.","landing.layers":"Слои","landing.layersDesc":"Организуйте работу по слоям и вложенным группам. Дублируйте, меняйте порядок, переименовывайте, скрывайте и показывайте слои. У каждого слоя свои клипы кадров для сложных анимаций.","landing.export":"Гибкий экспорт","landing.exportDesc":"Экспортируйте работу в PNG, анимированные GIF, спрайт-листы или видео MP4 в поддерживаемых браузерах. Масштаб экспорта — от 1x до 64x. Подходит для игровых движков Unity, Godot или GameMaker.","landing.palettes":"Цветовые палитры","landing.palettesDesc":"Встроенные палитры, включая цвета NES, а также собственные палитры, которые можно сохранять и редактировать. Выбирайте цвета с помощью ползунков RGB или HSL. Пипетка для выбора любого цвета на холсте.","landing.guideHeading":"Как нарисовать пиксель-арт","landing.guideStep1Title":"Выберите небольшой холст.","landing.guideStep1Desc":"16x16 или 32x32 — классический размер для персонажей, предметов и иконок.","landing.guideStep2Title":"Нарисуйте силуэт.","landing.guideStep2Desc":"Обведите контур карандашом в 1 пиксель одним тёмным цветом.","landing.guideStep3Title":"Залейте основные цвета.","landing.guideStep3Desc":"Используйте заливку и ограниченную палитру — для начала достаточно 4–8 цветов.","landing.guideStep4Title":"Добавьте свет и тень.","landing.guideStep4Desc":"Выберите направление света: более тёмный оттенок — с теневой стороны, более светлый — с освещённой.","landing.guideStep5Title":"Экспортируйте.","landing.guideStep5Desc":"Сохраните PNG в масштабе 4x или 8x, чтобы каждый пиксель оставался чётким.","landing.guideAnimationHeading":"Пиксельная анимация","landing.guideAnimationDesc":"Добавьте кадры, включите кальку и рисуйте движение шаг за шагом. Для анимации ожидания хватает 2–4 кадров, для цикла ходьбы обычно нужно 4–8. Частота 8–12 кадров в секунду обычно выглядит естественно. Готовую анимацию можно скачать как GIF, спрайт-лист или видео MP4.","landing.guideSchoolsHeading":"Для школ и Chromebook","landing.guideSchoolsDesc":"SpritePaint работает полностью в браузере, поэтому его можно использовать на школьных компьютерах и Chromebook без установки и без учётных записей.","landing.share":"Делитесь мгновенно","landing.shareDesc":"Создайте ссылку для общего доступа к анимации одним нажатием. Без регистрации. Получатели могут просматривать и воспроизводить анимацию спрайта прямо в браузере.","landing.howItWorks":"Как это работает","landing.step1Title":"Выберите размер холста","landing.step1Desc":"От 2x2 до 500x500. Популярные размеры: 16x16, 32x32, 64x64.","landing.step2Title":"Нарисуйте спрайт","landing.step2Desc":"Используйте карандаш, фигуры и заливку. Добавляйте слои для персонажей, фонов и эффектов.","landing.step3Title":"Анимируйте","landing.step3Desc":"Добавляйте кадры, используйте кальку, просматривайте на любой скорости.","landing.step4Title":"Экспортируйте и делитесь","landing.step4Desc":"Скачайте в формате PNG, GIF или спрайт-лист — или поделитесь ссылкой.","landing.faqHeading":"Часто задаваемые вопросы","landing.faq1Q":"SpritePaint действительно бесплатный?","landing.faq1A":"Да, полностью бесплатный. Никаких скрытых платежей, водяных знаков на экспорте или обязательной регистрации.","landing.faq2Q":"Нужно ли что-то скачивать?","landing.faq2A":"Нет. SpritePaint полностью работает в вашем браузере — Chrome, Firefox, Safari и Edge на Windows, Mac, Linux и Chromebook.","landing.faq3Q":"Какие форматы экспорта поддерживаются?","landing.faq3A":"PNG, анимированные GIF, спрайт-листы и видео MP4 в поддерживаемых браузерах. Любой экспорт можно масштабировать от 1x до 64x.","landing.faq4Q":"Можно ли создавать анимированные спрайты?","landing.faq4A":"Да! До 100 кадров с калькой. Экспорт в GIF или спрайт-лист для игровых движков Unity, Godot или GameMaker.","landing.faq5Q":"Моя работа будет сохранена?","landing.faq5A":"Ваша работа автоматически сохраняется в браузере. Вы также можете сохранить её в файл .spritepaint для резервного копирования или переноса на другой компьютер.","landing.faq6Q":"Какие размеры холста доступны?","landing.faq6A":"От 2x2 до 500x500 пикселей. Популярные размеры спрайтов: 8x8, 16x16, 32x32, 64x64. Размер можно изменить в любой момент и при желании масштабировать рисунок под новый размер.","landing.readyToCreate":"Готовы творить?","landing.joinArtists":"Присоединяйтесь к тысячам пиксель-художников. Начните рисовать за считанные секунды.","landing.openApp":"Открыть SpritePaint","landing.footer":"SpritePaint — Бесплатный онлайн-редактор пиксель-арта и спрайтов"},es:{"header.pencilOnly":"Dibujar solo con Apple Pencil","header.touchDrawing":"Dibujar con el dedo o Apple Pencil","header.drawingInput":"Entrada de dibujo","project.recoveryTitle":"¿Recuperar un proyecto dañado?","project.recoveryMessage":"El archivo contiene datos dañados. Puedes abrir una copia recuperada con los cambios que se indican abajo, o cancelar para conservar tu proyecto actual. El archivo original no se modificará.","project.recover":"Abrir copia recuperada","project.restoreDamaged":"Tu guardado en el navegador contiene datos dañados. No se ha reemplazado. Descarga una copia recuperada para revisar los cambios que se indican abajo.","storage.loadTitle":"No se puede abrir el almacenamiento del navegador","storage.loadMessage":"Una parte de SpritePaint no se pudo cargar. Vuelve a intentar abrir el editor. La edición está en pausa para proteger tu trabajo guardado.","storage.saveFailed":"Los cambios no se están guardando en este navegador. Descarga una copia del proyecto antes de cerrar.","storage.downloadFailed":"No se pudo descargar la copia del proyecto. Mantén esta pestaña abierta e inténtalo de nuevo.","storage.downloadCopy":"Descargar copia del proyecto","storage.retrySave":"Reintentar guardado","storage.retryOpen":"Reintentar apertura","storage.migrationTitle":"Tu proyecto se abrió, pero no se pudo guardar","storage.migrationMessage":"Tu copia guardada no se ha reemplazado. La edición está en pausa. Descarga una copia del proyecto, o libera almacenamiento del navegador y vuelve a intentarlo.","session.waitTitle":"Proyecto abierto en otra pestaña","session.waitMessage":"Cierra la otra pestaña del editor para continuar aquí. Esta pestaña cargará automáticamente tu último trabajo guardado.","session.errorTitle":"No se puede abrir el editor de forma segura","session.errorMessage":"Este navegador no pudo coordinar las pestañas de tu proyecto. Recarga en un navegador actualizado usando HTTPS.","session.restoreTitle":"No se puede restaurar tu proyecto","session.restoreMessage":"El editor no pudo cargar tu proyecto guardado. Intenta recargar esta pestaña. La edición está en pausa para proteger tu trabajo guardado.","tool.pencil":"Lápiz","tool.eraser":"Borrador","tool.line":"Línea","tool.circle":"Círculo","tool.square":"Cuadrado","tool.fill":"Rellenar","tool.eye-dropper":"Cuentagotas","tool.move":"Mover","tool.lasso":"Lazo libre","selection.move":"Mover selección","selection.scale":"Escalar selección","selection.rotate":"Rotar selección","selection.clear":"Eliminar selección","canvas.noLassoEmpty":"No se puede usar el lazo en un fotograma vacío. Desactívalo para empezar a dibujar.","canvas.layerHidden":"La capa está oculta.","canvas.groupMoveEmpty":"Mueve el cabezal de reproducción a un fotograma con contenido en este grupo.","canvas.groupHidden":"El grupo está oculto. Muéstralo junto con sus grupos superiores para editarlo.","canvas.groupSelected":"Usa Mover para mover todo el grupo. Selecciona una capa para usar otras herramientas.","canvas.groupLasso":"Selecciona una capa dentro de este grupo para usar el lazo. Desactiva el lazo para mover todo el grupo.","canvas.noMoveEmpty":"No se puede mover en un fotograma vacío.","canvas.noEyeDropperEmpty":"No se puede usar el cuentagotas en un fotograma vacío.","toolbar.smoothStabilizer":"Estabilizador suave","header.brushSize":"Tamaño del pincel","header.copy":"Copiar","header.paste":"Pegar","header.undo":"Deshacer","header.redo":"Rehacer","header.grid":"Cuadrícula","header.mirrorX":"Espejo X","header.mirrorY":"Espejo Y","header.pixelPerfect":"Píxel perfecto (lápiz 1px, espejo desactivado)","header.shapeFilled":"Forma rellena","header.fillModeConnected":"Conectado","header.fillModeAllMatching":"Todos coincidentes","header.fillModeConnectedTitle":"Rellenar solo píxeles conectados (contiguos)","header.fillModeAllMatchingTitle":"Rellenar todos los píxeles coincidentes","header.new":"Nuevo proyecto","header.download":"Descargar / Exportar","header.resizeCanvas":"Redimensionar lienzo","header.shareAnimation":"Compartir proyecto","header.saveProject":"Guardar proyecto","import.title":"Importar imagen","import.choose":"Elegir…","import.crop":"Recortar","import.expand":"Ampliar lienzo","import.expandLimit":"Ampliar lienzo (máx. 500 px)","import.fit":"Ajustar al lienzo","import.smooth":"Escalado suave","import.hidden":"El grupo de destino está oculto.","import.loading":"Cargando…","import.image":"Imagen","import.scale":"Escala","import.preview":"Vista previa de la imagen importada","import.confirm":"Importar","import.limit":"El tamaño del lienzo está limitado a 500 × 500 píxeles.","import.layerLimit":"El proyecto ya tiene 30 capas. Elimina una capa antes de importar.","import.depthLimit":"Este grupo está anidado demasiado. Selecciona un grupo superior antes de importar.","import.unavailable":"Detén la reproducción y usa la pestaña de edición activa para importar.","import.formatError":"Elige una imagen PNG, JPEG, GIF, WebP o BMP.","import.fileLimit":"Elige una imagen de menos de 25 MB.","import.pixelLimit":"Elige una imagen de no más de 16 millones de píxeles.","import.readError":"No se pudo abrir esta imagen. Prueba con otra.","import.anchor.top-left":"Arriba a la izquierda","import.anchor.top-center":"Arriba al centro","import.anchor.top-right":"Arriba a la derecha","import.anchor.middle-left":"Centro a la izquierda","import.anchor.center":"Centro","import.anchor.middle-right":"Centro a la derecha","import.anchor.bottom-left":"Abajo a la izquierda","import.anchor.bottom-center":"Abajo al centro","import.anchor.bottom-right":"Abajo a la derecha","header.loadProject":"Abrir proyecto","header.discord":"Discord","header.tutorials":"Tutoriales","header.feedback":"Comentarios","header.error.tooLarge":"El proyecto es demasiado grande para compartir por URL. Intenta reducir los fotogramas, las capas o el tamaño del lienzo.","header.error.noCompression":"Tu navegador no soporta compresión. Prueba un navegador moderno.","header.error.shareFailed":"No se pudo generar la URL para compartir.","header.error.loadFailed":"No se pudo cargar el archivo del proyecto.","timeline.insertFrame":"Insertar fotograma","timeline.moveFrameBackward":"Mover fotograma atrás","timeline.moveFrameForward":"Mover fotograma adelante","timeline.trimFrameLength":"Recortar duración del fotograma","timeline.extendFrameLength":"Extender duración del fotograma","timeline.deleteFrame":"Eliminar fotograma","timeline.splitClip":"Dividir clip","timeline.onionSkin":"Papel cebolla","timeline.lastFrame":"Fotograma anterior","timeline.playAnimation":"Reproducir animación","timeline.nextFrame":"Siguiente fotograma","timeline.currentFrame":"Fotograma actual","timeline.framesPerSecond":"Fotogramas por segundo","timeline.fps":"FPS","timeline.addLayer":"Añadir capa","timeline.cloneLayer":"Duplicar capa","timeline.moveLayerUp":"Mover capa arriba","timeline.moveLayerDown":"Mover capa abajo","timeline.deleteLayer":"Eliminar capa","color.title":"Color","color.hsl":"HSL","color.rgb":"RGB","color.current":"Color actual","color.previous":"Color anterior","color.restorePrevious":"Restaurar color anterior","color.addColor":"Añadir color","color.deleteColor":"Eliminar color","color.newPalette":"Nueva paleta","color.deletePalette":"Eliminar paleta","color.confirmDeletePalette":"¿Estás seguro de que quieres eliminar esta paleta?","dialog.newCanvas":"Nuevo lienzo","dialog.presets":"Preajustes","dialog.width":"Ancho","dialog.height":"Alto","dialog.cancel":"Cancelar","dialog.confirm":"Confirmar","dialog.download":"Descargar","dialog.type":"Tipo","dialog.gif":"GIF","dialog.frame":"Fotograma","dialog.spritesheet":"Hoja de sprites","dialog.size":"Tamaño","dialog.exporting":"Exportando...","dialog.saveProject":"Guardar proyecto","dialog.fileName":"Nombre del archivo","dialog.renameLayer":"Renombrar capa","dialog.renameGroup":"Renombrar grupo","dialog.name":"Nombre","dialog.saving":"Guardando...","dialog.saveError":"No se pudo guardar el proyecto.","dialog.shareAnimation":"Compartir proyecto","dialog.generatingLink":"Generando enlace...","dialog.shareInstruction":"Copia esta URL para compartir tu proyecto, incluidas las capas ocultas. Cualquiera con el enlace puede abrir una copia.","dialog.close":"Cerrar","dialog.copyToClipboard":"Copiar al portapapeles","dialog.copied":"¡Copiado!","dialog.resizeCanvas":"Redimensionar lienzo","dialog.resizeContents":"Redimensionar contenido","dialog.anchor":"Ancla","history.title":"Historial","dialog.versionUpgrade":"Aviso de actualización","shared.viewingMessage":"Estás viendo un proyecto compartido. Los cambios no se guardarán.","shared.backToProject":"Volver a mi proyecto","app.leaveConfirm":"¿Estás seguro de que quieres salir?","migrate.updateAlert":"¡Nueva actualización de SpritePaint! Las nuevas funciones incluyen:","migrate.lasso":"Herramienta de lazo básica","migrate.mirror":"Espejo para el lápiz: horizontal y vertical","migrate.filledShapes":"Formas rellenas para cuadrado y círculo","migrate.copyPaste":"Copiar y pegar selecciones dentro del fotograma o entre fotogramas","migrate.canvasResize":"Crear lienzos de cualquier tamaño y redimensionar durante el proyecto","migrate.pan":"Desplazar el lienzo manteniendo la barra espaciadora","migrate.extendTrim":"Extender y recortar la duración de los fotogramas","migrate.onionSkin":"Controlar la duración del papel cebolla","migrate.fps":"Editar y guardar la configuración de FPS","migrate.grid":"Activar y desactivar la cuadrícula","migrate.palettes":"Guardar, editar y eliminar paletas de colores","dialog.whatsNew":"Novedades","announce.intro":"SpritePaint se ha actualizado desde tu última visita. Las nuevas funciones incluyen:","announce.contact":"¿Preguntas o comentarios? Escríbenos a","feedback.title":"Comentarios","feedback.body":"¿Tienes una pregunta, encontraste un error o quieres una función nueva? El formulario es la forma más rápida de contactarnos: todo lo que envíes llega directo al equipo.","feedback.openForm":"Abrir formulario","feedback.orEmail":"¿Prefieres el correo? Escríbenos a","announce.clipMove":"Arrastra los dibujos por la línea de tiempo para moverlos","announce.clipTrim":"Arrastra cualquier borde de un dibujo en la línea de tiempo para extenderlo o recortarlo","announce.layerGroups":"Organiza las capas en grupos anidados. Mueve, redimensiona y gira sus dibujos juntos, o desplázalos en la línea de tiempo.","announce.toolControls":"Los controles muestran ahora las opciones del instrumento seleccionado.","announce.mp4":"Descarga animaciones en MP4, con progreso y cancelación en navegadores compatibles.","announce.projectProtection":"Nuevas alertas de errores al guardar, opciones de recuperación y protección ante cambios en varias pestañas.","announce.importImage":"Añade una imagen como una nueva capa desde la opción Importar imagen del menú. Recórtala, ajústala al lienzo o amplía el lienzo. Deshaz la importación en un solo paso.","export.output":"Salida:","export.perFrame":"por fotograma","export.padded":"Se ajustó a dimensiones pares para MP4.","export.tooLarge":"Este tamaño es demasiado grande para tu navegador. Elige uno más pequeño.","export.frames":"fotogramas","export.starting":"Iniciando…","export.rendering":"Renderizando","export.finalizing":"Finalizando…","landing.title":"SpritePaint — Editor gratuito de pixel art y sprites en línea","landing.metaDescription":"Editor gratuito de pixel art y herramienta de animación en línea. Dibuja sprites, anima fotograma a fotograma y exporta hojas de sprites, GIF y PNG. No requiere descargas.","landing.ogDescription":"Editor gratuito de pixel art y herramienta de animación en línea. Dibuja sprites, anima fotograma a fotograma y exporta hojas de sprites, GIF y PNG.","landing.startDrawing":"Empezar a dibujar","landing.heroTitle":"Editor de <span>Pixel Art</span> y sprites en línea","landing.heroSubtitle":"Dibuja sprites, anímalos fotograma a fotograma y expórtalos como PNG, GIF u hojas de sprites, directamente en tu navegador.","landing.noAccount":"Sin necesidad de cuenta","landing.featuresHeading":"Todo lo que necesitas, nada que sobre","landing.drawingTools":"Herramientas de dibujo","landing.drawingToolsDesc":"Lápiz, borrador, línea, círculo, rectángulo, bote de pintura, cuentagotas y selección de lazo. Tamaños de pincel ajustables de 1 a 64 píxeles. Dibujo en espejo en los ejes X e Y para sprites simétricos.","landing.animation":"Animación fotograma a fotograma","landing.animationDesc":"Crea sprites animados con hasta 100 fotogramas. El papel cebolla muestra los fotogramas anterior y siguiente como guía. Ajusta la velocidad de fotogramas y previsualiza tu animación en tiempo real.","landing.layers":"Capas","landing.layersDesc":"Organiza tu trabajo en capas y grupos anidados. Duplica, reordena, renombra y muestra u oculta capas. Cada capa tiene sus propios clips de fotogramas para animaciones complejas.","landing.export":"Exporta como quieras","landing.exportDesc":"Exporta tu trabajo como imágenes PNG, GIF animados, hojas de sprites o video MP4 en navegadores compatibles. Escala las exportaciones de 1x a 64x. Listo para motores de juego como Unity, Godot o GameMaker.","landing.palettes":"Paletas de colores","landing.palettesDesc":"Paletas integradas, incluidos los colores de NES, además de paletas propias que puedes guardar y editar. Elige colores con deslizadores RGB o HSL. Usa el cuentagotas para tomar cualquier color del lienzo.","landing.guideHeading":"Cómo dibujar pixel art","landing.guideStep1Title":"Elige un lienzo pequeño.","landing.guideStep1Desc":"16x16 o 32x32 es un tamaño clásico para personajes, objetos e iconos.","landing.guideStep2Title":"Dibuja la silueta.","landing.guideStep2Desc":"Traza el contorno con un lápiz de 1 píxel y un solo color oscuro.","landing.guideStep3Title":"Rellena los colores base.","landing.guideStep3Desc":"Usa el relleno y una paleta limitada: para empezar, bastan 4–8 colores.","landing.guideStep4Title":"Añade luces y sombras.","landing.guideStep4Desc":"Elige de dónde viene la luz: usa un tono más oscuro en el lado de la sombra y uno más claro en el lado iluminado.","landing.guideStep5Title":"Exporta.","landing.guideStep5Desc":"Guarda un PNG a 4x u 8x para que cada píxel se vea nítido.","landing.guideAnimationHeading":"Animación en pixel art","landing.guideAnimationDesc":"Añade fotogramas, activa el papel cebolla y dibuja el movimiento paso a paso. Una animación en reposo solo necesita 2–4 fotogramas; un ciclo de caminata suele llevar 4–8. Entre 8 y 12 fotogramas por segundo suele verse natural. Descarga la animación terminada como GIF, hoja de sprites o video MP4.","landing.guideSchoolsHeading":"Para escuelas y Chromebooks","landing.guideSchoolsDesc":"SpritePaint funciona completamente en el navegador, así que puedes usarlo en computadoras escolares y Chromebooks sin instalar nada y sin cuentas.","landing.share":"Comparte al instante","landing.shareDesc":"Genera un enlace para compartir tu animación con un clic. Sin necesidad de cuenta. Los destinatarios pueden ver y reproducir tu animación de sprites directamente en el navegador.","landing.howItWorks":"Cómo funciona","landing.step1Title":"Elige un tamaño de lienzo","landing.step1Desc":"Desde 2x2 hasta 500x500. Tamaños comunes: 16x16, 32x32, 64x64.","landing.step2Title":"Dibuja tu sprite","landing.step2Desc":"Usa lápiz, formas y relleno. Añade capas para personajes, fondos y efectos.","landing.step3Title":"Anímalo","landing.step3Desc":"Añade fotogramas, usa papel cebolla, previsualiza a cualquier velocidad.","landing.step4Title":"Exporta y comparte","landing.step4Desc":"Descarga como PNG, GIF u hoja de sprites — o comparte con un enlace.","landing.faqHeading":"Preguntas frecuentes","landing.faq1Q":"¿SpritePaint es realmente gratis?","landing.faq1A":"Sí, completamente gratis. Sin tarifas ocultas, sin marcas de agua en las exportaciones y sin necesidad de cuenta.","landing.faq2Q":"¿Necesito descargar algo?","landing.faq2A":"No. SpritePaint funciona completamente en tu navegador — Chrome, Firefox, Safari y Edge en Windows, Mac, Linux y Chromebook.","landing.faq3Q":"¿Qué formatos de exportación se admiten?","landing.faq3A":"Imágenes PNG, GIF animados, hojas de sprites y video MP4 en navegadores compatibles. Todas las exportaciones se pueden escalar de 1x a 64x.","landing.faq4Q":"¿Puedo crear sprites animados?","landing.faq4A":"¡Sí! Hasta 100 fotogramas con papel cebolla. Exporta como GIF u hoja de sprites para motores como Unity, Godot o GameMaker.","landing.faq5Q":"¿Se guardará mi trabajo?","landing.faq5A":"Tu trabajo se guarda automáticamente en el navegador. También puedes guardarlo como archivo .spritepaint para respaldarlo o transferirlo entre equipos.","landing.faq6Q":"¿Qué tamaños de lienzo puedo usar?","landing.faq6A":"Desde 2x2 hasta 500x500 píxeles. Tamaños populares de sprites: 8x8, 16x16, 32x32, 64x64. Cambia el tamaño cuando quieras y elige si escalar tu dibujo al nuevo tamaño.","landing.readyToCreate":"¿Listo para crear?","landing.joinArtists":"Únete a miles de artistas de pixel art. Empieza a dibujar en segundos.","landing.openApp":"Abrir SpritePaint","landing.footer":"SpritePaint — Editor gratuito de pixel art y sprites en línea"},"pt-BR":{"header.pencilOnly":"Desenhar apenas com Apple Pencil","header.touchDrawing":"Desenhar com o dedo ou Apple Pencil","header.drawingInput":"Entrada de desenho","project.recoveryTitle":"Recuperar um projeto danificado?","project.recoveryMessage":"O arquivo contém dados danificados. Você pode abrir uma cópia recuperada com as alterações listadas abaixo ou cancelar para manter seu projeto atual. O arquivo original não será alterado.","project.recover":"Abrir cópia recuperada","project.restoreDamaged":"Seu salvamento no navegador contém dados danificados. Ele não foi substituído. Baixe uma cópia recuperada para verificar as alterações listadas abaixo.","storage.loadTitle":"Não foi possível abrir o armazenamento do navegador","storage.loadMessage":"Parte do SpritePaint não carregou. Tente abrir o editor novamente. A edição está pausada para proteger seu trabalho salvo.","storage.saveFailed":"As alterações não estão sendo salvas neste navegador. Baixe uma cópia do projeto antes de fechar.","storage.downloadFailed":"Não foi possível baixar a cópia do projeto. Mantenha esta aba aberta e tente novamente.","storage.downloadCopy":"Baixar cópia do projeto","storage.retrySave":"Tentar salvar novamente","storage.retryOpen":"Tentar abrir novamente","storage.migrationTitle":"Seu projeto foi aberto, mas não pôde ser salvo","storage.migrationMessage":"Sua cópia salva não foi substituída. A edição está pausada. Baixe uma cópia do projeto ou libere espaço de armazenamento do navegador e tente novamente.","session.waitTitle":"Projeto aberto em outra aba","session.waitMessage":"Feche a outra aba do editor para continuar aqui. Esta aba carregará automaticamente seu trabalho salvo mais recente.","session.errorTitle":"Não foi possível abrir o editor com segurança","session.errorMessage":"Este navegador não conseguiu coordenar as abas do seu projeto. Recarregue em um navegador atualizado usando HTTPS.","session.restoreTitle":"Não foi possível restaurar seu projeto","session.restoreMessage":"O editor não conseguiu carregar seu projeto salvo. Tente recarregar esta aba. A edição está pausada para proteger seu trabalho salvo.","tool.pencil":"Lápis","tool.eraser":"Borracha","tool.line":"Linha","tool.circle":"Círculo","tool.square":"Quadrado","tool.fill":"Preencher","tool.eye-dropper":"Conta-gotas","tool.move":"Mover","tool.lasso":"Laço livre","selection.move":"Mover seleção","selection.scale":"Redimensionar seleção","selection.rotate":"Girar seleção","selection.clear":"Limpar seleção","canvas.noLassoEmpty":"Não é possível usar o laço em um quadro vazio. Desative para começar a desenhar.","canvas.layerHidden":"A camada está oculta.","canvas.groupMoveEmpty":"Mova o cursor de reprodução para um quadro com arte neste grupo.","canvas.groupHidden":"O grupo está oculto. Mostre-o e seus grupos superiores para editar.","canvas.groupSelected":"Use Mover para mover o grupo inteiro. Selecione uma camada para usar outras ferramentas.","canvas.groupLasso":"Selecione uma camada dentro deste grupo para usar o laço. Desative o laço para mover o grupo inteiro.","canvas.noMoveEmpty":"Não é possível mover em um quadro vazio.","canvas.noEyeDropperEmpty":"Não é possível usar o conta-gotas em um quadro vazio.","toolbar.smoothStabilizer":"Estabilizador suave","header.brushSize":"Tamanho do pincel","header.copy":"Copiar","header.paste":"Colar","header.undo":"Desfazer","header.redo":"Refazer","header.grid":"Grade","header.mirrorX":"Espelhar X","header.mirrorY":"Espelhar Y","header.pixelPerfect":"Pixel perfeito (lápis 1px, espelho desligado)","header.shapeFilled":"Forma preenchida","header.fillModeConnected":"Conectado","header.fillModeAllMatching":"Todos correspondentes","header.fillModeConnectedTitle":"Preencher apenas pixels conectados (contíguos)","header.fillModeAllMatchingTitle":"Preencher todos os pixels correspondentes","header.new":"Novo projeto","header.download":"Baixar / Exportar","header.resizeCanvas":"Redimensionar tela","header.shareAnimation":"Compartilhar projeto","header.saveProject":"Salvar projeto","import.title":"Importar imagem","import.choose":"Escolher…","import.crop":"Cortar","import.expand":"Expandir tela","import.expandLimit":"Expandir tela (máx. 500 px)","import.fit":"Ajustar à tela","import.smooth":"Redimensionamento suave","import.hidden":"O grupo de destino está oculto.","import.loading":"Carregando…","import.image":"Imagem","import.scale":"Escala","import.preview":"Prévia da imagem importada","import.confirm":"Importar","import.limit":"O tamanho da tela é limitado a 500 × 500 pixels.","import.layerLimit":"O projeto já tem 30 camadas. Remova uma camada antes de importar.","import.depthLimit":"Este grupo está aninhado demais. Selecione um grupo superior antes de importar.","import.unavailable":"Pare a reprodução e use a aba de edição ativa para importar.","import.formatError":"Escolha uma imagem PNG, JPEG, GIF, WebP ou BMP.","import.fileLimit":"Escolha uma imagem menor que 25 MB.","import.pixelLimit":"Escolha uma imagem com no máximo 16 milhões de pixels.","import.readError":"Não foi possível abrir esta imagem. Tente outra.","import.anchor.top-left":"Superior esquerdo","import.anchor.top-center":"Superior central","import.anchor.top-right":"Superior direito","import.anchor.middle-left":"Meio à esquerda","import.anchor.center":"Centro","import.anchor.middle-right":"Meio à direita","import.anchor.bottom-left":"Inferior esquerdo","import.anchor.bottom-center":"Inferior central","import.anchor.bottom-right":"Inferior direito","header.loadProject":"Abrir projeto","header.discord":"Discord","header.tutorials":"Tutoriais","header.feedback":"Feedback","header.error.tooLarge":"O projeto é grande demais para compartilhar por URL. Tente reduzir os quadros, as camadas ou o tamanho da tela.","header.error.noCompression":"Seu navegador não suporta compressão. Tente um navegador moderno.","header.error.shareFailed":"Falha ao gerar a URL de compartilhamento.","header.error.loadFailed":"Falha ao carregar o arquivo do projeto.","timeline.insertFrame":"Inserir quadro","timeline.moveFrameBackward":"Mover quadro para trás","timeline.moveFrameForward":"Mover quadro para frente","timeline.trimFrameLength":"Reduzir duração do quadro","timeline.extendFrameLength":"Estender duração do quadro","timeline.deleteFrame":"Excluir quadro","timeline.splitClip":"Dividir clipe","timeline.onionSkin":"Papel vegetal","timeline.lastFrame":"Quadro anterior","timeline.playAnimation":"Reproduzir animação","timeline.nextFrame":"Próximo quadro","timeline.currentFrame":"Quadro atual","timeline.framesPerSecond":"Quadros por segundo","timeline.fps":"QPS","timeline.addLayer":"Adicionar camada","timeline.cloneLayer":"Duplicar camada","timeline.moveLayerUp":"Mover camada acima","timeline.moveLayerDown":"Mover camada abaixo","timeline.deleteLayer":"Excluir camada","color.title":"Cor","color.hsl":"HSL","color.rgb":"RGB","color.current":"Cor atual","color.previous":"Cor anterior","color.restorePrevious":"Restaurar cor anterior","color.addColor":"Adicionar cor","color.deleteColor":"Excluir cor","color.newPalette":"Nova paleta","color.deletePalette":"Excluir paleta","color.confirmDeletePalette":"Tem certeza de que deseja excluir esta paleta?","dialog.newCanvas":"Nova tela","dialog.presets":"Predefinições","dialog.width":"Largura","dialog.height":"Altura","dialog.cancel":"Cancelar","dialog.confirm":"Confirmar","dialog.download":"Baixar","dialog.type":"Tipo","dialog.gif":"GIF","dialog.frame":"Quadro","dialog.spritesheet":"Folha de sprites","dialog.size":"Tamanho","dialog.exporting":"Exportando...","dialog.saveProject":"Salvar projeto","dialog.fileName":"Nome do arquivo","dialog.renameLayer":"Renomear camada","dialog.renameGroup":"Renomear grupo","dialog.name":"Nome","dialog.saving":"Salvando...","dialog.saveError":"Falha ao salvar o projeto.","dialog.shareAnimation":"Compartilhar projeto","dialog.generatingLink":"Gerando link...","dialog.shareInstruction":"Copie esta URL para compartilhar seu projeto, incluindo camadas ocultas. Qualquer pessoa com o link pode abrir uma cópia.","dialog.close":"Fechar","dialog.copyToClipboard":"Copiar para área de transferência","dialog.copied":"Copiado!","dialog.resizeCanvas":"Redimensionar tela","dialog.resizeContents":"Redimensionar conteúdo","dialog.anchor":"Âncora","history.title":"Histórico","dialog.versionUpgrade":"Aviso de atualização","shared.viewingMessage":"Você está visualizando um projeto compartilhado. As alterações não serão salvas.","shared.backToProject":"Voltar ao meu projeto","app.leaveConfirm":"Tem certeza de que deseja sair?","migrate.updateAlert":"Nova atualização do SpritePaint! Novos recursos incluem:","migrate.lasso":"Ferramenta de laço básica","migrate.mirror":"Espelhamento para o lápis: horizontal e vertical","migrate.filledShapes":"Formas preenchidas para quadrado e círculo","migrate.copyPaste":"Copiar e colar seleções dentro do quadro ou entre quadros","migrate.canvasResize":"Criar telas de qualquer tamanho e redimensionar durante o projeto","migrate.pan":"Navegar pela tela segurando a barra de espaço","migrate.extendTrim":"Estender e reduzir a duração dos quadros","migrate.onionSkin":"Controlar a duração do papel vegetal","migrate.fps":"Editar e salvar configurações de FPS","migrate.grid":"Ativar e desativar a grade","migrate.palettes":"Salvar, editar e excluir paletas de cores","dialog.whatsNew":"Novidades","announce.intro":"O SpritePaint foi atualizado desde sua última visita. Os novos recursos incluem:","announce.contact":"Dúvidas ou sugestões? Envie um e-mail para","feedback.title":"Feedback","feedback.body":"Tem uma dúvida, encontrou um bug ou quer uma nova função? O formulário é a forma mais rápida de falar conosco — tudo o que você enviar vai direto para a equipe.","feedback.openForm":"Abrir formulário","feedback.orEmail":"Prefere e-mail? Escreva para","announce.clipMove":"Arraste os desenhos pela linha do tempo para movê-los","announce.clipTrim":"Arraste qualquer borda de um desenho na linha do tempo para estendê-lo ou cortá-lo","announce.layerGroups":"Organize camadas em grupos aninhados. Mova, redimensione e gire seus desenhos juntos, ou desloque-os na linha do tempo.","announce.toolControls":"Os controles agora mostram as opções da ferramenta selecionada.","announce.mp4":"Baixe animações em MP4, com progresso e cancelamento em navegadores compatíveis.","announce.projectProtection":"Novos avisos de falha ao salvar, opções de recuperação e proteção contra edições conflitantes em várias abas.","announce.importImage":"Adicione uma imagem como uma nova camada pela opção Importar imagem do menu. Recorte, ajuste ao tamanho da tela ou expanda a tela. Desfaça a importação em uma única etapa.","export.output":"Saída:","export.perFrame":"por quadro","export.padded":"Ajustado para dimensões pares no MP4.","export.tooLarge":"Este tamanho é grande demais para o seu navegador. Escolha um tamanho menor.","export.frames":"quadros","export.starting":"Iniciando…","export.rendering":"Renderizando","export.finalizing":"Finalizando…","landing.title":"SpritePaint — Editor gratuito de pixel art e sprites online","landing.metaDescription":"Editor gratuito de pixel art e ferramenta de animação online. Desenhe sprites, anime quadro a quadro e exporte folhas de sprites, GIFs e PNGs. Sem download.","landing.ogDescription":"Editor gratuito de pixel art e ferramenta de animação online. Desenhe sprites, anime quadro a quadro e exporte folhas de sprites, GIFs e PNGs.","landing.startDrawing":"Começar a desenhar","landing.heroTitle":"Editor de <span>Pixel Art</span> e sprites online","landing.heroSubtitle":"Desenhe sprites, anime-os quadro a quadro e exporte como PNG, GIF ou folhas de sprites — direto no navegador.","landing.noAccount":"Sem necessidade de conta","landing.featuresHeading":"Tudo o que você precisa, nada de supérfluo","landing.drawingTools":"Ferramentas de desenho","landing.drawingToolsDesc":"Lápis, borracha, linha, círculo, retângulo, balde de tinta, conta-gotas e seleção de laço. Tamanhos de pincel ajustáveis de 1 a 64 pixels. Desenho espelhado nos eixos X e Y para sprites simétricos.","landing.animation":"Animação quadro a quadro","landing.animationDesc":"Crie sprites animados com até 100 quadros. O papel vegetal mostra os quadros anteriores e seguintes como guia. Defina taxas de quadros personalizadas e visualize sua animação em tempo real.","landing.layers":"Camadas","landing.layersDesc":"Organize seu trabalho em camadas e grupos aninhados. Duplique, reordene, renomeie e mostre ou oculte camadas. Cada camada tem seus próprios clipes de quadros para animações complexas.","landing.export":"Exporte como quiser","landing.exportDesc":"Exporte seu trabalho como imagens PNG, GIFs animados, folhas de sprites ou vídeo MP4 em navegadores compatíveis. Escale as exportações de 1x a 64x. Pronto para motores de jogos como Unity, Godot ou GameMaker.","landing.palettes":"Paletas de cores","landing.palettesDesc":"Paletas integradas, incluindo as cores do NES, além de paletas próprias que você pode salvar e editar. Escolha cores com controles deslizantes RGB ou HSL. Use o conta-gotas para capturar qualquer cor da tela.","landing.guideHeading":"Como desenhar pixel art","landing.guideStep1Title":"Escolha uma tela pequena.","landing.guideStep1Desc":"16x16 ou 32x32 é um tamanho clássico para personagens, itens e ícones.","landing.guideStep2Title":"Desenhe a silhueta.","landing.guideStep2Desc":"Contorne a forma com um lápis de 1 pixel e uma única cor escura.","landing.guideStep3Title":"Preencha as cores base.","landing.guideStep3Desc":"Use o preenchimento e uma paleta limitada — para começar, 4–8 cores bastam.","landing.guideStep4Title":"Adicione luz e sombra.","landing.guideStep4Desc":"Escolha a direção da luz: use um tom mais escuro no lado da sombra e um mais claro no lado iluminado.","landing.guideStep5Title":"Exporte.","landing.guideStep5Desc":"Salve um PNG em 4x ou 8x para que cada pixel continue nítido.","landing.guideAnimationHeading":"Animação em pixel art","landing.guideAnimationDesc":"Adicione quadros, ative o papel vegetal e desenhe o movimento passo a passo. Uma animação parada precisa de apenas 2–4 quadros; um ciclo de caminhada costuma levar 4–8. Algo entre 8 e 12 quadros por segundo costuma parecer natural. Baixe a animação pronta como GIF, folha de sprites ou vídeo MP4.","landing.guideSchoolsHeading":"Para escolas e Chromebooks","landing.guideSchoolsDesc":"O SpritePaint funciona inteiramente no navegador, então dá para usá-lo em computadores da escola e Chromebooks sem instalar nada e sem contas.","landing.share":"Compartilhe instantaneamente","landing.shareDesc":"Gere um link para compartilhar sua animação com um clique. Sem necessidade de conta. Os destinatários podem visualizar e reproduzir sua animação de sprites diretamente no navegador.","landing.howItWorks":"Como funciona","landing.step1Title":"Escolha o tamanho da tela","landing.step1Desc":"De 2x2 até 500x500. Tamanhos comuns: 16x16, 32x32, 64x64.","landing.step2Title":"Desenhe seu sprite","landing.step2Desc":"Use lápis, formas e preenchimento. Adicione camadas para personagens, fundos e efeitos.","landing.step3Title":"Crie a animação","landing.step3Desc":"Adicione quadros, use papel vegetal, visualize em qualquer velocidade.","landing.step4Title":"Exporte e compartilhe","landing.step4Desc":"Baixe como PNG, GIF ou folha de sprites — ou compartilhe com um link.","landing.faqHeading":"Perguntas frequentes","landing.faq1Q":"O SpritePaint é realmente gratuito?","landing.faq1A":"Sim, completamente gratuito. Sem taxas ocultas, sem marcas d'água nas exportações, sem necessidade de conta.","landing.faq2Q":"Preciso baixar algo?","landing.faq2A":"Não. O SpritePaint funciona inteiramente no seu navegador — Chrome, Firefox, Safari e Edge no Windows, Mac, Linux e Chromebook.","landing.faq3Q":"Quais formatos de exportação são suportados?","landing.faq3A":"Imagens PNG, GIFs animados, folhas de sprites e vídeo MP4 em navegadores compatíveis. Todas as exportações podem ser escaladas de 1x a 64x.","landing.faq4Q":"Posso criar sprites animados?","landing.faq4A":"Sim! Até 100 quadros com papel vegetal. Exporte como GIF ou folha de sprites para motores como Unity, Godot ou GameMaker.","landing.faq5Q":"Meu trabalho será salvo?","landing.faq5A":"Seu trabalho é salvo automaticamente no navegador. Você também pode salvar como arquivo .spritepaint para backup ou transferência entre computadores.","landing.faq6Q":"Quais tamanhos de tela posso usar?","landing.faq6A":"De 2x2 até 500x500 pixels. Tamanhos populares de sprites: 8x8, 16x16, 32x32, 64x64. Redimensione quando quiser e escolha se o desenho deve ser escalado para o novo tamanho.","landing.readyToCreate":"Pronto para criar?","landing.joinArtists":"Junte-se a milhares de artistas de pixel art. Comece a desenhar em segundos.","landing.openApp":"Abrir SpritePaint","landing.footer":"SpritePaint — Editor gratuito de pixel art e sprites online"},ja:{"header.pencilOnly":"Apple Pencilのみで描画","header.touchDrawing":"指またはApple Pencilで描画","header.drawingInput":"描画入力","project.recoveryTitle":"破損したプロジェクトを復元しますか？","project.recoveryMessage":"ファイルに破損したデータが含まれています。以下の変更を加えた復元コピーを開くか、キャンセルして現在のプロジェクトを維持できます。元のファイルは変更されません。","project.recover":"復元コピーを開く","project.restoreDamaged":"ブラウザの保存データに破損したデータが含まれています。保存データは置き換えられていません。復元コピーをダウンロードして、以下の変更を確認してください。","storage.loadTitle":"ブラウザのストレージを開けません","storage.loadMessage":"SpritePaintの一部を読み込めませんでした。エディターをもう一度開いてください。保存済みの作品を保護するため、編集を一時停止しています。","storage.saveFailed":"変更はこのブラウザに保存されていません。閉じる前にプロジェクトのコピーをダウンロードしてください。","storage.downloadFailed":"プロジェクトのコピーをダウンロードできませんでした。このタブを開いたまま、もう一度お試しください。","storage.downloadCopy":"プロジェクトのコピーをダウンロード","storage.retrySave":"保存を再試行","storage.retryOpen":"再度開く","storage.migrationTitle":"プロジェクトは開きましたが、保存できませんでした","storage.migrationMessage":"既存の保存コピーは置き換えられていません。編集を一時停止しています。プロジェクトのコピーをダウンロードするか、ブラウザのストレージを空けて再試行してください。","session.waitTitle":"プロジェクトが別のタブで開かれています","session.waitMessage":"ここで続けるには、もう一方のエディタータブを閉じてください。このタブは最新の保存済み作品を自動的に読み込みます。","session.errorTitle":"エディターを安全に開けません","session.errorMessage":"このブラウザではプロジェクトのタブを連携できませんでした。HTTPSを使用して最新のブラウザで再読み込みしてください。","session.restoreTitle":"プロジェクトを復元できません","session.restoreMessage":"エディターで保存済みのプロジェクトを読み込めませんでした。このタブを再読み込みしてください。保存済みの作品を保護するため、編集を一時停止しています。","tool.pencil":"鉛筆","tool.eraser":"消しゴム","tool.line":"直線","tool.circle":"円","tool.square":"四角","tool.fill":"塗りつぶし","tool.eye-dropper":"スポイト","tool.move":"移動","tool.lasso":"フリーハンド投げ縄","selection.move":"選択範囲を移動","selection.scale":"選択範囲を拡大縮小","selection.rotate":"選択範囲を回転","selection.clear":"選択を解除","canvas.noLassoEmpty":"空のフレームではラッソを使用できません。無効にして描画を開始してください。","canvas.layerHidden":"レイヤーが非表示です。","canvas.groupMoveEmpty":"再生ヘッドを、このグループにアートワークがあるフレームへ移動してください。","canvas.groupHidden":"グループが非表示です。編集するには、このグループと親グループを表示してください。","canvas.groupSelected":"グループ全体を動かすには移動ツールを使用してください。他のツールを使うにはレイヤーを選択してください。","canvas.groupLasso":"ラッソを使うには、このグループ内のレイヤーを選択してください。グループ全体を動かすにはラッソをオフにしてください。","canvas.noMoveEmpty":"空のフレームでは移動ツールを使用できません。","canvas.noEyeDropperEmpty":"空のフレームではスポイトツールを使用できません。","toolbar.smoothStabilizer":"スムーズスタビライザー","header.brushSize":"ブラシサイズ","header.copy":"コピー","header.paste":"貼り付け","header.undo":"元に戻す","header.redo":"やり直し","header.grid":"グリッド","header.mirrorX":"X軸ミラー","header.mirrorY":"Y軸ミラー","header.pixelPerfect":"ピクセルパーフェクト（1pxペンシル、ミラーオフ）","header.shapeFilled":"塗りつぶし図形","header.fillModeConnected":"接続","header.fillModeAllMatching":"すべて一致","header.fillModeConnectedTitle":"接続されたピクセルのみを塗りつぶす（隣接）","header.fillModeAllMatchingTitle":"一致するすべてのピクセルを塗りつぶす","header.new":"新規プロジェクト","header.download":"ダウンロード / 書き出し","header.resizeCanvas":"キャンバスのリサイズ","header.shareAnimation":"プロジェクトを共有","header.saveProject":"プロジェクトを保存","import.title":"画像を読み込む","import.choose":"選択…","import.crop":"切り抜く","import.expand":"キャンバスを拡張","import.expandLimit":"キャンバスを拡張（最大 500 px）","import.fit":"キャンバスに合わせる","import.smooth":"なめらかに拡大縮小","import.hidden":"追加先のグループは非表示です。","import.loading":"読み込み中…","import.image":"画像","import.scale":"倍率","import.preview":"読み込む画像のプレビュー","import.confirm":"読み込む","import.limit":"キャンバスサイズは最大 500 × 500 ピクセルです。","import.layerLimit":"プロジェクトのレイヤーはすでに 30 枚です。読み込む前にレイヤーを削除してください。","import.depthLimit":"このグループは階層が深すぎます。読み込む前に親グループを選択してください。","import.unavailable":"再生を停止し、編集中のタブで読み込んでください。","import.formatError":"PNG、JPEG、GIF、WebP、BMP 画像を選択してください。","import.fileLimit":"25 MB 未満の画像を選択してください。","import.pixelLimit":"1,600 万ピクセル以下の画像を選択してください。","import.readError":"この画像を開けませんでした。別の画像をお試しください。","import.anchor.top-left":"左上","import.anchor.top-center":"上中央","import.anchor.top-right":"右上","import.anchor.middle-left":"左中央","import.anchor.center":"中央","import.anchor.middle-right":"右中央","import.anchor.bottom-left":"左下","import.anchor.bottom-center":"下中央","import.anchor.bottom-right":"右下","header.loadProject":"プロジェクトを開く","header.discord":"Discord","header.tutorials":"チュートリアル","header.feedback":"フィードバック","header.error.tooLarge":"プロジェクトが大きすぎてURLで共有できません。フレーム数、レイヤー数、またはキャンバスサイズを減らしてください。","header.error.noCompression":"お使いのブラウザは圧縮に対応していません。最新のブラウザをお試しください。","header.error.shareFailed":"共有URLの生成に失敗しました。","header.error.loadFailed":"プロジェクトファイルの読み込みに失敗しました。","timeline.insertFrame":"フレームを挿入","timeline.moveFrameBackward":"フレームを前に移動","timeline.moveFrameForward":"フレームを後ろに移動","timeline.trimFrameLength":"フレームの長さを短縮","timeline.extendFrameLength":"フレームの長さを延長","timeline.deleteFrame":"フレームを削除","timeline.splitClip":"クリップを分割","timeline.onionSkin":"オニオンスキン","timeline.lastFrame":"前のフレーム","timeline.playAnimation":"アニメーション再生","timeline.nextFrame":"次のフレーム","timeline.currentFrame":"現在のフレーム","timeline.framesPerSecond":"フレーム/秒","timeline.fps":"FPS","timeline.addLayer":"レイヤーを追加","timeline.cloneLayer":"レイヤーを複製","timeline.moveLayerUp":"レイヤーを上に移動","timeline.moveLayerDown":"レイヤーを下に移動","timeline.deleteLayer":"レイヤーを削除","color.title":"カラー","color.hsl":"HSL","color.rgb":"RGB","color.current":"現在の色","color.previous":"前の色","color.restorePrevious":"前の色に戻す","color.addColor":"色を追加","color.deleteColor":"色を削除","color.newPalette":"新しいパレット","color.deletePalette":"パレットを削除","color.confirmDeletePalette":"このパレットを削除してもよろしいですか？","dialog.newCanvas":"新しいキャンバス","dialog.presets":"プリセット","dialog.width":"幅","dialog.height":"高さ","dialog.cancel":"キャンセル","dialog.confirm":"確認","dialog.download":"ダウンロード","dialog.type":"形式","dialog.gif":"GIF","dialog.frame":"フレーム","dialog.spritesheet":"スプライトシート","dialog.size":"サイズ","dialog.exporting":"エクスポート中...","dialog.saveProject":"プロジェクトを保存","dialog.fileName":"ファイル名","dialog.renameLayer":"レイヤー名を変更","dialog.renameGroup":"グループ名を変更","dialog.name":"名前","dialog.saving":"保存中...","dialog.saveError":"プロジェクトの保存に失敗しました。","dialog.shareAnimation":"プロジェクトを共有","dialog.generatingLink":"共有リンクを生成中...","dialog.shareInstruction":"このURLをコピーして、非表示レイヤーを含むプロジェクトを共有できます。リンクを持つ人は誰でもコピーを開けます。","dialog.close":"閉じる","dialog.copyToClipboard":"クリップボードにコピー","dialog.copied":"コピーしました！","dialog.resizeCanvas":"キャンバスのリサイズ","dialog.resizeContents":"コンテンツをリサイズ","dialog.anchor":"アンカー","history.title":"履歴","dialog.versionUpgrade":"バージョンアップデートのお知らせ","shared.viewingMessage":"共有プロジェクトを閲覧中です。変更は保存されません。","shared.backToProject":"自分のプロジェクトに戻る","app.leaveConfirm":"ページを離れてもよろしいですか？","migrate.updateAlert":"SpritePaintの新しいアップデート！新機能：","migrate.lasso":"基本的な投げ縄ツールを追加","migrate.mirror":"鉛筆にミラー設定：水平・垂直","migrate.filledShapes":"四角と円に塗りつぶし図形を追加","migrate.copyPaste":"フレーム内またはフレーム間で選択範囲のコピー＆ペースト","migrate.canvasResize":"任意のサイズのキャンバスを作成し、制作中にリサイズ可能","migrate.pan":"スペースキーを押しながらキャンバスをパン","migrate.extendTrim":"フレームの長さを延長・短縮","migrate.onionSkin":"オニオンスキンの長さを調整","migrate.fps":"FPS設定の編集と保存","migrate.grid":"グリッドの表示・非表示","migrate.palettes":"カラーパレットの保存・編集・削除","dialog.whatsNew":"新機能","announce.intro":"前回の訪問以降、SpritePaintが更新されました。新機能：","announce.contact":"ご質問やご意見はこちらまで：","feedback.title":"フィードバック","feedback.body":"ご質問、バグ報告、機能のご要望はありますか？フィードバックフォームが最も早い連絡手段です。送信内容はすべて直接チームに届きます。","feedback.openForm":"フォームを開く","feedback.orEmail":"メールをご希望の場合はこちらまで：","announce.clipMove":"タイムライン上でドラッグして描画を移動","announce.clipTrim":"タイムライン上の描画の左右の端をドラッグして長さを伸縮","announce.layerGroups":"レイヤーを入れ子のグループに整理。絵をまとめて移動・拡大縮小・回転したり、タイムライン上でタイミングを移動したりできます。","announce.toolControls":"選択したツールに合わせて設定項目が切り替わります。","announce.mp4":"対応ブラウザーでアニメーションをMP4動画としてダウンロード。進行状況の表示とキャンセルにも対応。","announce.projectProtection":"保存失敗の通知、復元オプション、複数タブでの編集競合を防ぐ機能を追加しました。","announce.importImage":"メニューの「画像を読み込む」から、画像を新しいレイヤーとして追加できます。切り抜き、キャンバスに合わせた縮小、キャンバスの拡張に対応。インポートは1回の操作で元に戻せます。","export.output":"出力:","export.perFrame":"（1フレームあたり）","export.padded":"MP4用に偶数サイズへ余白を追加しました。","export.tooLarge":"このサイズはブラウザで扱えません。小さいサイズを選んでください。","export.frames":"フレーム","export.starting":"開始中…","export.rendering":"レンダリング中","export.finalizing":"仕上げ中…","landing.title":"SpritePaint — 無料オンラインドット絵メーカー＆スプライトエディタ","landing.metaDescription":"無料のオンラインドット絵メーカー＆アニメーションツール。スプライトを描き、1コマずつアニメーションを作成し、スプライトシート、GIF、PNGでエクスポート。ダウンロード不要。","landing.ogDescription":"無料のオンラインドット絵メーカー＆アニメーションツール。スプライトを描き、1コマずつアニメーションを作成し、スプライトシート、GIF、PNGでエクスポート。","landing.startDrawing":"描き始める","landing.heroTitle":"オンライン<span>ドット絵</span>メーカー＆スプライトエディタ","landing.heroSubtitle":"スプライトを描いて1コマずつアニメーションし、PNG・GIF・スプライトシートでエクスポート。すべてブラウザだけで完結します。","landing.noAccount":"アカウント不要","landing.featuresHeading":"必要なものだけ、余計なものはなし","landing.drawingTools":"描画ツール","landing.drawingToolsDesc":"鉛筆、消しゴム、直線、円、四角、塗りつぶし、スポイト、投げ縄選択。ブラシサイズは1〜64ピクセルまで調整可能。X軸・Y軸ミラー描画で対称スプライトの作成に対応。","landing.animation":"フレームアニメーション","landing.animationDesc":"最大100フレームのアニメーションスプライトを作成。オニオンスキンで前後のフレームをガイド表示。カスタムフレームレートを設定し、リアルタイムでプレビュー。","landing.layers":"レイヤー","landing.layersDesc":"レイヤーと入れ子のグループで作品を整理。レイヤーの複製、並べ替え、名前変更、表示・非表示の切り替えが可能。レイヤーごとに独立したフレームクリップを持てるので、複雑なアニメーションも作れます。","landing.export":"多彩なエクスポート","landing.exportDesc":"PNG画像、アニメーションGIF、スプライトシート、MP4動画（対応ブラウザー）でエクスポート。倍率は1xから64xまで選べます。Unity、Godot、GameMakerなどのゲームエンジンに対応。","landing.palettes":"カラーパレット","landing.palettesDesc":"NESカラーを含む内蔵パレットに加え、自分で保存・編集できるパレットも使えます。RGBまたはHSLスライダーで色を選択。スポイトツールでキャンバス上の任意の色をサンプリング。","landing.guideHeading":"ドット絵の描き方","landing.guideStep1Title":"小さなキャンバスを選ぶ。","landing.guideStep1Desc":"キャラクター、アイテム、アイコンには16x16や32x32が定番のサイズです。","landing.guideStep2Title":"シルエットを描く。","landing.guideStep2Desc":"1ピクセルの鉛筆と暗い色1色で輪郭を描きます。","landing.guideStep3Title":"基本色を塗る。","landing.guideStep3Desc":"塗りつぶしと限られたパレットを使いましょう。最初は4〜8色で十分です。","landing.guideStep4Title":"光と影を加える。","landing.guideStep4Desc":"光の向きを決め、影側には暗い色、光が当たる側には明るい色を置きます。","landing.guideStep5Title":"エクスポートする。","landing.guideStep5Desc":"ピクセルがくっきり見えるよう、4xまたは8xでPNGを保存します。","landing.guideAnimationHeading":"ドット絵アニメーション","landing.guideAnimationDesc":"フレームを追加し、オニオンスキンをオンにして、動きを1コマずつ描きます。待機アニメーションなら2〜4フレーム、歩行サイクルは通常4〜8フレームで作れます。8〜12fps前後が自然に見えることが多いです。完成したアニメーションはGIF、スプライトシート、MP4動画でダウンロードできます。","landing.guideSchoolsHeading":"学校やChromebookで","landing.guideSchoolsDesc":"SpritePaintはブラウザだけで動作するので、学校のパソコンやChromebookでもインストール不要・アカウント不要で使えます。","landing.share":"すぐに共有","landing.shareDesc":"ワンクリックでアニメーションの共有リンクを生成。アカウント不要。受信者はブラウザで直接スプライトアニメーションを閲覧・再生できます。","landing.howItWorks":"使い方","landing.step1Title":"キャンバスサイズを選択","landing.step1Desc":"2x2から500x500まで。一般的なサイズ：16x16、32x32、64x64。","landing.step2Title":"スプライトを描く","landing.step2Desc":"鉛筆、図形、塗りつぶしを使用。キャラクター、背景、エフェクト用にレイヤーを追加。","landing.step3Title":"アニメーションを作成","landing.step3Desc":"フレームを追加し、オニオンスキンを使い、任意の速度でプレビュー。","landing.step4Title":"エクスポート＆共有","landing.step4Desc":"PNG、GIF、スプライトシートでダウンロード — またはリンクで共有。","landing.faqHeading":"よくある質問","landing.faq1Q":"SpritePaintは本当に無料ですか？","landing.faq1A":"はい、完全に無料です。隠れた料金なし、エクスポートに透かしなし、アカウント不要。","landing.faq2Q":"何かダウンロードする必要がありますか？","landing.faq2A":"いいえ。SpritePaintはブラウザ上で完全に動作します — Windows、Mac、Linux、ChromebookのChrome、Firefox、Safari、Edge対応。","landing.faq3Q":"対応しているエクスポート形式は？","landing.faq3A":"PNG画像、アニメーションGIF、スプライトシート、MP4動画（対応ブラウザー）。どのエクスポートも1xから64xまで拡大できます。","landing.faq4Q":"アニメーションスプライトは作れますか？","landing.faq4A":"はい！オニオンスキン付きで最大100フレーム。Unity、Godot、GameMakerなどのゲームエンジン向けにGIFまたはスプライトシートでエクスポート。","landing.faq5Q":"作品は保存されますか？","landing.faq5A":"作品はブラウザに自動保存されます。.spritepaintファイルとして保存し、バックアップやPC間の移行も可能です。","landing.faq6Q":"どのキャンバスサイズが使えますか？","landing.faq6A":"2x2から500x500ピクセルまで。人気のスプライトサイズ：8x8、16x16、32x32、64x64。いつでもサイズを変更でき、作品を新しいサイズに合わせて拡大縮小するかも選べます。","landing.readyToCreate":"さっそく作ってみませんか？","landing.joinArtists":"何千人ものドット絵アーティストの仲間入りをしましょう。数秒で描き始められます。","landing.openApp":"SpritePaintを開く","landing.footer":"SpritePaint — 無料オンラインドット絵メーカー＆スプライトエディタ"},"zh-CN":{"header.pencilOnly":"仅使用 Apple Pencil 绘画","header.touchDrawing":"使用手指或 Apple Pencil 绘画","header.drawingInput":"绘画输入","project.recoveryTitle":"恢复已损坏的项目？","project.recoveryMessage":"该文件包含已损坏的数据。你可以打开包含下列更改的恢复副本，或取消以保留当前项目。原始文件不会被更改。","project.recover":"打开恢复副本","project.restoreDamaged":"浏览器中的存档包含已损坏的数据，且未被替换。请下载恢复副本以检查下列更改。","storage.loadTitle":"无法打开浏览器存储","storage.loadMessage":"SpritePaint 的部分内容未能加载。请重试打开编辑器。为保护已保存的作品，编辑已暂停。","storage.saveFailed":"更改未保存到此浏览器。关闭前请下载项目副本。","storage.downloadFailed":"无法下载项目副本。请保持此标签页打开并重试。","storage.downloadCopy":"下载项目副本","storage.retrySave":"重试保存","storage.retryOpen":"重试打开","storage.migrationTitle":"项目已打开，但无法保存","storage.migrationMessage":"现有的已保存副本未被替换。编辑已暂停。请下载项目副本，或释放浏览器存储空间后重试。","session.waitTitle":"项目已在另一个标签页中打开","session.waitMessage":"关闭另一个编辑器标签页即可在此继续。此标签页将自动加载你最新保存的作品。","session.errorTitle":"无法安全打开编辑器","session.errorMessage":"此浏览器无法协调你的项目标签页。请使用最新版浏览器通过 HTTPS 重新加载。","session.restoreTitle":"无法恢复你的项目","session.restoreMessage":"编辑器无法加载你保存的项目。请尝试重新加载此标签页。为保护已保存的作品，编辑已暂停。","tool.pencil":"铅笔","tool.eraser":"橡皮擦","tool.line":"直线","tool.circle":"圆形","tool.square":"方形","tool.fill":"填充","tool.eye-dropper":"吸管","tool.move":"移动","tool.lasso":"自由套索","selection.move":"移动选区","selection.scale":"缩放选区","selection.rotate":"旋转选区","selection.clear":"取消选区","canvas.noLassoEmpty":"空帧上无法使用套索。关闭套索即可开始绘画。","canvas.layerHidden":"图层已隐藏。","canvas.groupMoveEmpty":"请将播放头移到此组中有作品的帧。","canvas.groupHidden":"组已隐藏。显示该组及其父组后即可编辑。","canvas.groupSelected":"使用移动工具可移动整个组。选择一个图层以使用其他工具。","canvas.groupLasso":"选择此组内的图层以使用套索。关闭套索可移动整个组。","canvas.noMoveEmpty":"空帧上无法使用移动工具。","canvas.noEyeDropperEmpty":"空帧上无法使用吸管工具。","toolbar.smoothStabilizer":"平滑稳定器","header.brushSize":"画笔大小","header.copy":"复制","header.paste":"粘贴","header.undo":"撤销","header.redo":"重做","header.grid":"网格","header.mirrorX":"X轴镜像","header.mirrorY":"Y轴镜像","header.pixelPerfect":"像素完美（1px铅笔，镜像关闭）","header.shapeFilled":"填充图形","header.fillModeConnected":"连续","header.fillModeAllMatching":"所有匹配","header.fillModeConnectedTitle":"仅填充连续像素（相邻）","header.fillModeAllMatchingTitle":"填充所有匹配像素","header.new":"新建项目","header.download":"下载 / 导出","header.resizeCanvas":"调整画布大小","header.shareAnimation":"分享项目","header.saveProject":"保存项目","import.title":"导入图片","import.choose":"选择…","import.crop":"裁剪","import.expand":"扩展画布","import.expandLimit":"扩展画布（最大 500 px）","import.fit":"缩放以适应画布","import.smooth":"平滑缩放","import.hidden":"目标组已隐藏。","import.loading":"正在加载…","import.image":"图片","import.scale":"缩放","import.preview":"导入图片预览","import.confirm":"导入","import.limit":"画布大小上限为 500 × 500 像素。","import.layerLimit":"项目已有 30 个图层。请先删除一个图层再导入。","import.depthLimit":"此组嵌套层级过深。请先选择上级组再导入。","import.unavailable":"请停止播放，并在当前编辑标签页中导入。","import.formatError":"请选择 PNG、JPEG、GIF、WebP 或 BMP 图片。","import.fileLimit":"请选择小于 25 MB 的图片。","import.pixelLimit":"请选择不超过 1600 万像素的图片。","import.readError":"无法打开此图片。请尝试其他图片。","import.anchor.top-left":"左上","import.anchor.top-center":"顶部居中","import.anchor.top-right":"右上","import.anchor.middle-left":"左侧居中","import.anchor.center":"居中","import.anchor.middle-right":"右侧居中","import.anchor.bottom-left":"左下","import.anchor.bottom-center":"底部居中","import.anchor.bottom-right":"右下","header.loadProject":"打开项目","header.discord":"Discord","header.tutorials":"教程","header.feedback":"反馈","header.error.tooLarge":"项目太大，无法通过URL分享。请尝试减少帧数、图层数或画布大小。","header.error.noCompression":"您的浏览器不支持压缩。请尝试使用现代浏览器。","header.error.shareFailed":"生成分享链接失败。","header.error.loadFailed":"加载项目文件失败。","timeline.insertFrame":"插入帧","timeline.moveFrameBackward":"向前移动帧","timeline.moveFrameForward":"向后移动帧","timeline.trimFrameLength":"缩短帧长度","timeline.extendFrameLength":"延长帧长度","timeline.deleteFrame":"删除帧","timeline.splitClip":"分割片段","timeline.onionSkin":"洋葱皮","timeline.lastFrame":"上一帧","timeline.playAnimation":"播放动画","timeline.nextFrame":"下一帧","timeline.currentFrame":"当前帧","timeline.framesPerSecond":"每秒帧数","timeline.fps":"FPS","timeline.addLayer":"添加图层","timeline.cloneLayer":"复制图层","timeline.moveLayerUp":"上移图层","timeline.moveLayerDown":"下移图层","timeline.deleteLayer":"删除图层","color.title":"颜色","color.hsl":"HSL","color.rgb":"RGB","color.current":"当前颜色","color.previous":"上一个颜色","color.restorePrevious":"恢复上一个颜色","color.addColor":"添加颜色","color.deleteColor":"删除颜色","color.newPalette":"新建调色板","color.deletePalette":"删除调色板","color.confirmDeletePalette":"确定要删除此调色板吗？","dialog.newCanvas":"新建画布","dialog.presets":"预设","dialog.width":"宽度","dialog.height":"高度","dialog.cancel":"取消","dialog.confirm":"确认","dialog.download":"下载","dialog.type":"类型","dialog.gif":"GIF","dialog.frame":"帧","dialog.spritesheet":"精灵图集","dialog.size":"大小","dialog.exporting":"导出中...","dialog.saveProject":"保存项目","dialog.fileName":"文件名","dialog.renameLayer":"重命名图层","dialog.renameGroup":"重命名组","dialog.name":"名称","dialog.saving":"保存中...","dialog.saveError":"项目保存失败。","dialog.shareAnimation":"分享项目","dialog.generatingLink":"正在生成分享链接...","dialog.shareInstruction":"复制此链接来分享您的项目（包括隐藏图层）。任何拥有链接的人都可以打开一份副本。","dialog.close":"关闭","dialog.copyToClipboard":"复制到剪贴板","dialog.copied":"已复制！","dialog.resizeCanvas":"调整画布大小","dialog.resizeContents":"调整内容大小","dialog.anchor":"锚点","history.title":"历史记录","dialog.versionUpgrade":"版本更新通知","shared.viewingMessage":"您正在查看共享项目。更改不会被保存。","shared.backToProject":"返回我的项目","app.leaveConfirm":"确定要离开吗？","migrate.updateAlert":"SpritePaint 新版更新！新功能包括：","migrate.lasso":"新增基本套索工具","migrate.mirror":"铅笔镜像设置：水平和垂直","migrate.filledShapes":"方形和圆形新增填充图形","migrate.copyPaste":"在帧内或帧间复制和粘贴选区","migrate.canvasResize":"创建任意大小的画布，项目进行中可调整大小","migrate.pan":"按住空格键平移画板","migrate.extendTrim":"延长和缩短帧的长度","migrate.onionSkin":"控制洋葱皮的帧长度","migrate.fps":"编辑和保存帧率设置","migrate.grid":"启用和禁用网格","migrate.palettes":"保存、编辑和删除调色板","dialog.whatsNew":"新功能","announce.intro":"自您上次访问以来，SpritePaint 已更新。新功能包括：","announce.contact":"有问题或反馈？请发送邮件至","feedback.title":"反馈","feedback.body":"有问题、发现了 bug 或想要新功能？反馈表单是联系我们最快的方式，您提交的内容会直接送达团队。","feedback.openForm":"打开反馈表单","feedback.orEmail":"更喜欢邮件？请发送至","announce.clipMove":"在时间轴上拖动绘图以移动它们","announce.clipTrim":"拖动时间轴中绘图的任一边缘以延长或缩短它","announce.layerGroups":"将图层整理为嵌套分组。一起移动、缩放和旋转分组中的图画，或在时间轴上调整其时间位置。","announce.toolControls":"工具选项现在会随所选工具切换。","announce.mp4":"在支持的浏览器中将动画下载为MP4视频，并查看导出进度或取消导出。","announce.projectProtection":"新增保存失败提醒、恢复选项，以及防止多个标签页编辑冲突的保护功能。","announce.importImage":"通过菜单中的“导入图片”，将图片添加为新图层。可裁剪、缩放以适应画布，或扩展画布。只需一步即可撤销导入。","export.output":"输出：","export.perFrame":"每帧","export.padded":"已为 MP4 补齐为偶数尺寸。","export.tooLarge":"此尺寸超出浏览器的处理能力，请选择更小的尺寸。","export.frames":"帧","export.starting":"正在开始…","export.rendering":"正在渲染","export.finalizing":"正在完成…","landing.title":"SpritePaint — 免费在线像素画制作工具和精灵图编辑器","landing.metaDescription":"免费在线像素画制作和动画工具。绘制精灵图，逐帧制作动画，导出精灵图集、GIF和PNG。无需下载。","landing.ogDescription":"免费在线像素画制作和动画工具。绘制精灵图，逐帧制作动画，导出精灵图集、GIF和PNG。","landing.startDrawing":"开始绘制","landing.heroTitle":"在线<span>像素画</span>制作工具和精灵图编辑器","landing.heroSubtitle":"绘制精灵图，逐帧制作动画，并导出为PNG、GIF或精灵图集——全部在浏览器中完成。","landing.noAccount":"无需注册账号","landing.featuresHeading":"功能一应俱全，绝无冗余","landing.drawingTools":"绘图工具","landing.drawingToolsDesc":"铅笔、橡皮擦、直线、圆形、矩形、填充桶、吸管和套索选择。画笔大小可调节，从1到64像素。X轴和Y轴镜像绘制，轻松创建对称精灵图。","landing.animation":"逐帧动画","landing.animationDesc":"创建最多100帧的动画精灵图。洋葱皮显示前后帧作为参考。设置自定义帧率，实时预览动画。","landing.layers":"图层","landing.layersDesc":"用图层和嵌套分组整理作品。复制、重新排序、重命名以及显示或隐藏图层。每个图层都有独立的帧片段，便于制作复杂动画。","landing.export":"灵活导出","landing.exportDesc":"导出为PNG图像、动画GIF、精灵图集，或在支持的浏览器中导出MP4视频。导出比例可从1x到64x。适配Unity、Godot或GameMaker等游戏引擎。","landing.palettes":"调色板","landing.palettesDesc":"内置调色板，包括NES颜色，还可以保存和编辑自己的调色板。使用RGB或HSL滑块选择颜色。吸管工具可采样画布上的任意颜色。","landing.guideHeading":"如何绘制像素画","landing.guideStep1Title":"选择小尺寸画布。","landing.guideStep1Desc":"16x16或32x32是角色、道具和图标的经典尺寸。","landing.guideStep2Title":"画出轮廓。","landing.guideStep2Desc":"用1像素铅笔和一种深色勾勒外形。","landing.guideStep3Title":"填充基础色。","landing.guideStep3Desc":"使用填充工具和有限的调色板——刚开始用4–8种颜色就足够了。","landing.guideStep4Title":"添加光影。","landing.guideStep4Desc":"确定光源方向：背光面用较深的颜色，受光面用较浅的颜色。","landing.guideStep5Title":"导出。","landing.guideStep5Desc":"以4x或8x导出PNG，让每个像素都保持清晰。","landing.guideAnimationHeading":"像素动画","landing.guideAnimationDesc":"添加帧，开启洋葱皮，一步一步画出动作。待机动画只需2–4帧，行走循环通常需要4–8帧。每秒8–12帧通常看起来比较自然。完成后可将动画下载为GIF、精灵图集或MP4视频。","landing.guideSchoolsHeading":"适用于学校和Chromebook","landing.guideSchoolsDesc":"SpritePaint完全在浏览器中运行，因此无需安装、无需账号，即可在学校电脑和Chromebook上使用。","landing.share":"即时分享","landing.shareDesc":"一键生成动画分享链接。无需账号。接收者可以直接在浏览器中查看和播放您的精灵动画。","landing.howItWorks":"使用方法","landing.step1Title":"选择画布大小","landing.step1Desc":"从2x2到500x500。常用尺寸：16x16、32x32、64x64。","landing.step2Title":"绘制精灵图","landing.step2Desc":"使用铅笔、形状和填充。为角色、背景和特效添加图层。","landing.step3Title":"制作动画","landing.step3Desc":"添加帧，使用洋葱皮，以任意速度预览。","landing.step4Title":"导出和分享","landing.step4Desc":"下载为PNG、GIF或精灵图集 — 或通过链接分享。","landing.faqHeading":"常见问题","landing.faq1Q":"SpritePaint真的免费吗？","landing.faq1A":"是的，完全免费。没有隐藏费用，导出无水印，无需注册账号。","landing.faq2Q":"需要下载什么吗？","landing.faq2A":"不需要。SpritePaint完全在浏览器中运行 — 支持Windows、Mac、Linux和Chromebook上的Chrome、Firefox、Safari和Edge。","landing.faq3Q":"支持哪些导出格式？","landing.faq3A":"PNG图像、动画GIF、精灵图集，以及在支持的浏览器中导出的MP4视频。所有导出都可在1x到64x之间缩放。","landing.faq4Q":"可以制作动画精灵图吗？","landing.faq4A":"可以！最多100帧，带洋葱皮功能。导出为GIF或精灵图集，适用于Unity、Godot或GameMaker等游戏引擎。","landing.faq5Q":"我的作品会被保存吗？","landing.faq5A":"您的作品会自动保存到浏览器中。您也可以保存为.spritepaint文件进行备份或在不同电脑间传输。","landing.faq6Q":"可以使用哪些画布大小？","landing.faq6A":"从2x2到500x500像素。常用精灵图尺寸：8x8、16x16、32x32、64x64。可随时调整画布大小，并可选择是否将作品缩放到新尺寸。","landing.readyToCreate":"准备好创作了吗？","landing.joinArtists":"与数千名像素画师一起创作。几秒钟即可开始绘制。","landing.openApp":"打开SpritePaint","landing.footer":"SpritePaint — 免费在线像素画制作工具和精灵图编辑器"},ko:{"header.pencilOnly":"Apple Pencil로만 그리기","header.touchDrawing":"손가락 또는 Apple Pencil로 그리기","header.drawingInput":"그리기 입력","project.recoveryTitle":"손상된 프로젝트를 복구할까요?","project.recoveryMessage":"파일에 손상된 데이터가 있습니다. 아래 변경 사항이 적용된 복구 사본을 열거나, 취소하여 현재 프로젝트를 유지할 수 있습니다. 원본 파일은 변경되지 않습니다.","project.recover":"복구 사본 열기","project.restoreDamaged":"브라우저 저장 데이터에 손상된 데이터가 있습니다. 저장 데이터는 교체되지 않았습니다. 복구 사본을 다운로드하여 아래 변경 사항을 확인하세요.","storage.loadTitle":"브라우저 저장소를 열 수 없습니다","storage.loadMessage":"SpritePaint 일부를 불러오지 못했습니다. 편집기를 다시 열어 보세요. 저장된 작업을 보호하기 위해 편집이 일시 중지되었습니다.","storage.saveFailed":"변경 사항이 이 브라우저에 저장되지 않고 있습니다. 닫기 전에 프로젝트 사본을 다운로드하세요.","storage.downloadFailed":"프로젝트 사본을 다운로드하지 못했습니다. 이 탭을 연 채로 다시 시도하세요.","storage.downloadCopy":"프로젝트 사본 다운로드","storage.retrySave":"다시 저장","storage.retryOpen":"다시 열기","storage.migrationTitle":"프로젝트를 열었지만 저장할 수 없습니다","storage.migrationMessage":"기존에 저장된 사본은 교체되지 않았습니다. 편집이 일시 중지되었습니다. 프로젝트 사본을 다운로드하거나 브라우저 저장 공간을 확보한 후 다시 시도하세요.","session.waitTitle":"다른 탭에서 프로젝트가 열려 있습니다","session.waitMessage":"여기서 계속하려면 다른 편집기 탭을 닫으세요. 이 탭은 가장 최근에 저장된 작업을 자동으로 불러옵니다.","session.errorTitle":"편집기를 안전하게 열 수 없습니다","session.errorMessage":"이 브라우저에서 프로젝트 탭을 조정할 수 없습니다. HTTPS를 사용하는 최신 브라우저에서 다시 불러오세요.","session.restoreTitle":"프로젝트를 복원할 수 없습니다","session.restoreMessage":"편집기가 저장된 프로젝트를 불러오지 못했습니다. 이 탭을 새로고침해 보세요. 저장된 작업을 보호하기 위해 편집이 일시 중지되었습니다.","tool.pencil":"연필","tool.eraser":"지우개","tool.line":"선","tool.circle":"원","tool.square":"사각형","tool.fill":"채우기","tool.eye-dropper":"스포이트","tool.move":"이동","tool.lasso":"자유형 올가미","selection.move":"선택 영역 이동","selection.scale":"선택 영역 크기 조정","selection.rotate":"선택 영역 회전","selection.clear":"선택 해제","canvas.noLassoEmpty":"빈 프레임에서는 올가미를 사용할 수 없습니다. 비활성화하여 그리기를 시작하세요.","canvas.layerHidden":"레이어가 숨겨져 있습니다.","canvas.groupMoveEmpty":"재생 헤드를 이 그룹에 작품이 있는 프레임으로 옮기세요.","canvas.groupHidden":"그룹이 숨겨져 있습니다. 편집하려면 이 그룹과 상위 그룹을 표시하세요.","canvas.groupSelected":"그룹 전체를 옮기려면 이동 도구를 사용하세요. 다른 도구를 사용하려면 레이어를 선택하세요.","canvas.groupLasso":"올가미를 사용하려면 이 그룹 안의 레이어를 선택하세요. 그룹 전체를 옮기려면 올가미를 끄세요.","canvas.noMoveEmpty":"빈 프레임에서는 이동 도구를 사용할 수 없습니다.","canvas.noEyeDropperEmpty":"빈 프레임에서는 스포이트 도구를 사용할 수 없습니다.","toolbar.smoothStabilizer":"부드러운 안정기","header.brushSize":"브러시 크기","header.copy":"복사","header.paste":"붙여넣기","header.undo":"실행 취소","header.redo":"다시 실행","header.grid":"격자","header.mirrorX":"X축 미러","header.mirrorY":"Y축 미러","header.pixelPerfect":"픽셀 퍼펙트 (1px 연필, 미러 꺼짐)","header.shapeFilled":"채워진 도형","header.fillModeConnected":"연결된","header.fillModeAllMatching":"모두 일치","header.fillModeConnectedTitle":"연결된 픽셀만 채우기 (인접)","header.fillModeAllMatchingTitle":"일치하는 모든 픽셀 채우기","header.new":"새 프로젝트","header.download":"다운로드 / 내보내기","header.resizeCanvas":"캔버스 크기 조정","header.shareAnimation":"프로젝트 공유","header.saveProject":"프로젝트 저장","import.title":"이미지 가져오기","import.choose":"선택…","import.crop":"자르기","import.expand":"캔버스 확장","import.expandLimit":"캔버스 확장(최대 500px)","import.fit":"캔버스에 맞추기","import.smooth":"부드러운 크기 조정","import.hidden":"대상 그룹이 숨겨져 있습니다.","import.loading":"불러오는 중…","import.image":"이미지","import.scale":"배율","import.preview":"가져올 이미지 미리보기","import.confirm":"가져오기","import.limit":"캔버스 크기는 최대 500 × 500 픽셀입니다.","import.layerLimit":"프로젝트에 이미 레이어가 30개 있습니다. 가져오기 전에 레이어를 삭제하세요.","import.depthLimit":"이 그룹은 너무 깊이 중첩되어 있습니다. 가져오기 전에 상위 그룹을 선택하세요.","import.unavailable":"재생을 멈추고 편집 중인 탭에서 가져오세요.","import.formatError":"PNG, JPEG, GIF, WebP 또는 BMP 이미지를 선택하세요.","import.fileLimit":"25MB보다 작은 이미지를 선택하세요.","import.pixelLimit":"1,600만 픽셀 이하의 이미지를 선택하세요.","import.readError":"이 이미지를 열 수 없습니다. 다른 이미지를 시도해 보세요.","import.anchor.top-left":"왼쪽 위","import.anchor.top-center":"위쪽 가운데","import.anchor.top-right":"오른쪽 위","import.anchor.middle-left":"왼쪽 가운데","import.anchor.center":"가운데","import.anchor.middle-right":"오른쪽 가운데","import.anchor.bottom-left":"왼쪽 아래","import.anchor.bottom-center":"아래쪽 가운데","import.anchor.bottom-right":"오른쪽 아래","header.loadProject":"프로젝트 열기","header.discord":"Discord","header.tutorials":"튜토리얼","header.feedback":"피드백","header.error.tooLarge":"프로젝트가 너무 커서 URL로 공유할 수 없습니다. 프레임, 레이어 수나 캔버스 크기를 줄여보세요.","header.error.noCompression":"브라우저가 압축을 지원하지 않습니다. 최신 브라우저를 사용해보세요.","header.error.shareFailed":"공유 URL 생성에 실패했습니다.","header.error.loadFailed":"프로젝트 파일을 불러오지 못했습니다.","timeline.insertFrame":"프레임 삽입","timeline.moveFrameBackward":"프레임 뒤로 이동","timeline.moveFrameForward":"프레임 앞으로 이동","timeline.trimFrameLength":"프레임 길이 줄이기","timeline.extendFrameLength":"프레임 길이 늘리기","timeline.deleteFrame":"프레임 삭제","timeline.splitClip":"클립 분할","timeline.onionSkin":"어니언 스킨","timeline.lastFrame":"이전 프레임","timeline.playAnimation":"애니메이션 재생","timeline.nextFrame":"다음 프레임","timeline.currentFrame":"현재 프레임","timeline.framesPerSecond":"초당 프레임","timeline.fps":"FPS","timeline.addLayer":"레이어 추가","timeline.cloneLayer":"레이어 복제","timeline.moveLayerUp":"레이어 위로 이동","timeline.moveLayerDown":"레이어 아래로 이동","timeline.deleteLayer":"레이어 삭제","color.title":"색상","color.hsl":"HSL","color.rgb":"RGB","color.current":"현재 색상","color.previous":"이전 색상","color.restorePrevious":"이전 색상 복원","color.addColor":"색상 추가","color.deleteColor":"색상 삭제","color.newPalette":"새 팔레트","color.deletePalette":"팔레트 삭제","color.confirmDeletePalette":"이 팔레트를 삭제하시겠습니까?","dialog.newCanvas":"새 캔버스","dialog.presets":"프리셋","dialog.width":"너비","dialog.height":"높이","dialog.cancel":"취소","dialog.confirm":"확인","dialog.download":"다운로드","dialog.type":"유형","dialog.gif":"GIF","dialog.frame":"프레임","dialog.spritesheet":"스프라이트 시트","dialog.size":"크기","dialog.exporting":"내보내는 중...","dialog.saveProject":"프로젝트 저장","dialog.fileName":"파일 이름","dialog.renameLayer":"레이어 이름 변경","dialog.renameGroup":"그룹 이름 변경","dialog.name":"이름","dialog.saving":"저장 중...","dialog.saveError":"프로젝트 저장에 실패했습니다.","dialog.shareAnimation":"프로젝트 공유","dialog.generatingLink":"공유 링크 생성 중...","dialog.shareInstruction":"이 URL을 복사하여 숨긴 레이어를 포함한 프로젝트를 공유하세요. 링크가 있는 누구나 사본을 열 수 있습니다.","dialog.close":"닫기","dialog.copyToClipboard":"클립보드에 복사","dialog.copied":"복사됨!","dialog.resizeCanvas":"캔버스 크기 조정","dialog.resizeContents":"내용 크기 조정","dialog.anchor":"기준점","history.title":"기록","dialog.versionUpgrade":"버전 업데이트 안내","shared.viewingMessage":"공유된 프로젝트를 보고 있습니다. 변경 사항은 저장되지 않습니다.","shared.backToProject":"내 프로젝트로 돌아가기","app.leaveConfirm":"페이지를 떠나시겠습니까?","migrate.updateAlert":"SpritePaint 새 업데이트! 새로운 기능:","migrate.lasso":"기본 올가미 도구 추가","migrate.mirror":"연필 미러 설정: 수평 및 수직","migrate.filledShapes":"사각형과 원에 채워진 도형 추가","migrate.copyPaste":"프레임 내 또는 프레임 간 선택 영역 복사 및 붙여넣기","migrate.canvasResize":"모든 크기의 캔버스를 만들고 작업 중 크기 조정 가능","migrate.pan":"스페이스바를 누른 채로 캔버스 이동","migrate.extendTrim":"프레임 길이 늘리기 및 줄이기","migrate.onionSkin":"어니언 스킨 프레임 길이 조절","migrate.fps":"FPS 설정 편집 및 저장","migrate.grid":"격자 켜기/끄기","migrate.palettes":"색상 팔레트 저장, 편집, 삭제","dialog.whatsNew":"새로운 기능","announce.intro":"마지막 방문 이후 SpritePaint가 업데이트되었습니다. 새로운 기능:","announce.contact":"질문이나 의견이 있으신가요? 이메일:","feedback.title":"피드백","feedback.body":"질문이 있거나 버그를 발견했거나 새 기능을 원하시나요? 피드백 양식이 가장 빠른 연락 방법입니다. 보내주신 내용은 모두 팀에 바로 전달됩니다.","feedback.openForm":"피드백 양식 열기","feedback.orEmail":"이메일을 선호하시나요? 이메일:","announce.clipMove":"타임라인에서 그림을 드래그하여 이동","announce.clipTrim":"타임라인에서 그림의 양쪽 가장자리를 드래그하여 늘리거나 줄이기","announce.layerGroups":"레이어를 중첩 그룹으로 정리하세요. 그룹의 그림을 함께 이동, 크기 조절, 회전하거나 타임라인에서 시점을 옮길 수 있습니다.","announce.toolControls":"선택한 도구에 맞는 설정이 표시됩니다.","announce.mp4":"지원되는 브라우저에서 애니메이션을 MP4로 다운로드하고 내보내기 진행 상황을 확인하거나 취소하세요.","announce.projectProtection":"저장 실패 알림, 복구 옵션, 여러 탭 사이의 편집 충돌 방지 기능이 추가되었습니다.","announce.importImage":"메뉴의 이미지 가져오기로 이미지를 새 레이어에 추가하세요. 자르기, 캔버스에 맞춰 축소하기, 캔버스 확장을 선택할 수 있습니다. 가져오기는 한 번에 실행 취소할 수 있습니다.","export.output":"출력:","export.perFrame":"(프레임당)","export.padded":"MP4용으로 짝수 크기에 맞게 여백을 추가했습니다.","export.tooLarge":"이 크기는 브라우저에서 처리하기에 너무 큽니다. 더 작은 크기를 선택하세요.","export.frames":"프레임","export.starting":"시작 중…","export.rendering":"렌더링 중","export.finalizing":"마무리 중…","landing.title":"SpritePaint — 무료 온라인 픽셀 아트 메이커 & 스프라이트 에디터","landing.metaDescription":"무료 온라인 픽셀 아트 메이커 및 애니메이션 도구. 스프라이트를 그리고, 프레임별 애니메이션을 만들고, 스프라이트 시트, GIF, PNG로 내보내기. 다운로드 불필요.","landing.ogDescription":"무료 온라인 픽셀 아트 메이커 및 애니메이션 도구. 스프라이트를 그리고, 프레임별 애니메이션을 만들고, 스프라이트 시트, GIF, PNG로 내보내기.","landing.startDrawing":"그리기 시작","landing.heroTitle":"온라인 <span>픽셀 아트</span> 메이커 & 스프라이트 에디터","landing.heroSubtitle":"스프라이트를 그리고, 프레임 단위로 애니메이션을 만들고, PNG, GIF 또는 스프라이트 시트로 내보내세요. 모두 브라우저에서 바로 할 수 있습니다.","landing.noAccount":"계정 불필요","landing.featuresHeading":"필요한 것만, 불필요한 것은 없이","landing.drawingTools":"그리기 도구","landing.drawingToolsDesc":"연필, 지우개, 선, 원, 사각형, 채우기 버킷, 스포이트, 올가미 선택. 1~64픽셀까지 조절 가능한 브러시 크기. X축 및 Y축 미러 그리기로 대칭 스프라이트 제작.","landing.animation":"프레임별 애니메이션","landing.animationDesc":"최대 100프레임의 애니메이션 스프라이트 제작. 어니언 스킨으로 이전/다음 프레임을 가이드로 표시. 사용자 정의 프레임 레이트 설정 및 실시간 미리보기.","landing.layers":"레이어","landing.layersDesc":"레이어와 중첩 그룹으로 작업을 정리하세요. 레이어 복제, 재정렬, 이름 변경, 표시/숨기기를 지원합니다. 각 레이어는 복잡한 애니메이션을 위한 독립 프레임 클립을 가집니다.","landing.export":"다양한 형식으로 내보내기","landing.exportDesc":"PNG 이미지, 애니메이션 GIF, 스프라이트 시트 또는 MP4 동영상(지원되는 브라우저)으로 내보내기. 내보내기 배율은 1x부터 64x까지. Unity, Godot, GameMaker 등 게임 엔진에 바로 사용.","landing.palettes":"색상 팔레트","landing.palettesDesc":"NES 색상을 포함한 내장 팔레트에 직접 저장하고 편집할 수 있는 팔레트까지. RGB 또는 HSL 슬라이더로 색상 선택. 스포이트 도구로 캔버스의 모든 색상 샘플링.","landing.guideHeading":"픽셀 아트 그리는 법","landing.guideStep1Title":"작은 캔버스를 고르세요.","landing.guideStep1Desc":"16x16 또는 32x32는 캐릭터, 아이템, 아이콘에 많이 쓰이는 기본 크기입니다.","landing.guideStep2Title":"실루엣을 그리세요.","landing.guideStep2Desc":"1픽셀 연필과 어두운 색 하나로 외곽선을 그립니다.","landing.guideStep3Title":"기본 색을 채우세요.","landing.guideStep3Desc":"채우기 도구와 제한된 팔레트를 사용하세요. 처음에는 4~8가지 색이면 충분합니다.","landing.guideStep4Title":"빛과 그림자를 더하세요.","landing.guideStep4Desc":"빛의 방향을 정하고, 그림자 쪽에는 더 어두운 색을, 빛을 받는 쪽에는 더 밝은 색을 칠합니다.","landing.guideStep5Title":"내보내세요.","landing.guideStep5Desc":"모든 픽셀이 선명하게 보이도록 PNG를 4x 또는 8x로 저장합니다.","landing.guideAnimationHeading":"픽셀 애니메이션","landing.guideAnimationDesc":"프레임을 추가하고 어니언 스킨을 켠 다음, 움직임을 한 단계씩 그리세요. 대기 애니메이션은 2~4프레임이면 충분하고, 걷기 사이클은 보통 4~8프레임이 필요합니다. 초당 8~12프레임이면 대체로 자연스러워 보입니다. 완성한 애니메이션은 GIF, 스프라이트 시트 또는 MP4 동영상으로 다운로드할 수 있습니다.","landing.guideSchoolsHeading":"학교와 Chromebook에서","landing.guideSchoolsDesc":"SpritePaint는 브라우저에서 완전히 작동하므로 설치나 계정 없이 학교 컴퓨터와 Chromebook에서 사용할 수 있습니다.","landing.share":"즉시 공유","landing.shareDesc":"한 번의 클릭으로 애니메이션 공유 링크 생성. 계정 불필요. 수신자는 브라우저에서 직접 스프라이트 애니메이션을 보고 재생할 수 있습니다.","landing.howItWorks":"사용 방법","landing.step1Title":"캔버스 크기 선택","landing.step1Desc":"2x2부터 500x500까지. 일반적인 크기: 16x16, 32x32, 64x64.","landing.step2Title":"스프라이트 그리기","landing.step2Desc":"연필, 도형, 채우기 사용. 캐릭터, 배경, 효과용 레이어 추가.","landing.step3Title":"애니메이션 만들기","landing.step3Desc":"프레임 추가, 어니언 스킨 사용, 원하는 속도로 미리보기.","landing.step4Title":"내보내기 및 공유","landing.step4Desc":"PNG, GIF 또는 스프라이트 시트로 다운로드 — 또는 링크로 공유.","landing.faqHeading":"자주 묻는 질문","landing.faq1Q":"SpritePaint는 정말 무료인가요?","landing.faq1A":"네, 완전히 무료입니다. 숨겨진 비용도, 내보내기 워터마크도 없고 계정도 필요 없습니다.","landing.faq2Q":"다운로드가 필요한가요?","landing.faq2A":"아니요. SpritePaint는 브라우저에서 완전히 작동합니다 — Windows, Mac, Linux, Chromebook의 Chrome, Firefox, Safari, Edge 지원.","landing.faq3Q":"어떤 내보내기 형식을 지원하나요?","landing.faq3A":"PNG 이미지, 애니메이션 GIF, 스프라이트 시트, 그리고 지원되는 브라우저에서 MP4 동영상. 모든 내보내기는 1x부터 64x까지 배율을 조정할 수 있습니다.","landing.faq4Q":"애니메이션 스프라이트를 만들 수 있나요?","landing.faq4A":"네! 어니언 스킨과 함께 최대 100프레임. Unity, Godot, GameMaker 등 게임 엔진용으로 GIF 또는 스프라이트 시트로 내보내기.","landing.faq5Q":"작업이 저장되나요?","landing.faq5A":"작업은 브라우저에 자동 저장됩니다. .spritepaint 파일로 저장하여 백업하거나 다른 컴퓨터로 옮길 수도 있습니다.","landing.faq6Q":"어떤 캔버스 크기를 사용할 수 있나요?","landing.faq6A":"2x2부터 500x500픽셀까지. 인기 스프라이트 크기: 8x8, 16x16, 32x32, 64x64. 언제든 크기를 바꿀 수 있고, 그림을 새 크기에 맞게 조정할지도 선택할 수 있습니다.","landing.readyToCreate":"만들 준비가 되셨나요?","landing.joinArtists":"수천 명의 픽셀 아트 아티스트와 함께하세요. 몇 초 만에 바로 그리기를 시작할 수 있습니다.","landing.openApp":"SpritePaint 열기","landing.footer":"SpritePaint — 무료 온라인 픽셀 아트 메이커 & 스프라이트 에디터"},de:{"header.pencilOnly":"Nur mit Apple Pencil zeichnen","header.touchDrawing":"Mit Finger oder Apple Pencil zeichnen","header.drawingInput":"Zeicheneingabe","project.recoveryTitle":"Beschädigtes Projekt wiederherstellen?","project.recoveryMessage":"Die Datei enthält beschädigte Daten. Du kannst eine wiederhergestellte Kopie mit den unten aufgeführten Änderungen öffnen oder abbrechen, um dein aktuelles Projekt zu behalten. Die Originaldatei wird nicht verändert.","project.recover":"Wiederhergestellte Kopie öffnen","project.restoreDamaged":"Dein Browser-Speicherstand enthält beschädigte Daten. Er wurde nicht ersetzt. Lade eine wiederhergestellte Kopie herunter, um die unten aufgeführten Änderungen zu prüfen.","storage.loadTitle":"Browser-Speicher kann nicht geöffnet werden","storage.loadMessage":"Ein Teil von SpritePaint konnte nicht geladen werden. Versuche erneut, den Editor zu öffnen. Die Bearbeitung ist pausiert, um deine gespeicherte Arbeit zu schützen.","storage.saveFailed":"Änderungen werden in diesem Browser nicht gespeichert. Lade vor dem Schließen eine Projektkopie herunter.","storage.downloadFailed":"Die Projektkopie konnte nicht heruntergeladen werden. Lass diesen Tab geöffnet und versuche es erneut.","storage.downloadCopy":"Projektkopie herunterladen","storage.retrySave":"Speichern wiederholen","storage.retryOpen":"Öffnen wiederholen","storage.migrationTitle":"Dein Projekt wurde geöffnet, konnte aber nicht gespeichert werden","storage.migrationMessage":"Deine vorhandene gespeicherte Kopie wurde nicht ersetzt. Die Bearbeitung ist pausiert. Lade eine Projektkopie herunter oder gib Browser-Speicher frei und versuche es erneut.","session.waitTitle":"Projekt in einem anderen Tab geöffnet","session.waitMessage":"Schließe den anderen Editor-Tab, um hier fortzufahren. Dieser Tab lädt automatisch deine zuletzt gespeicherte Arbeit.","session.errorTitle":"Editor kann nicht sicher geöffnet werden","session.errorMessage":"Dieser Browser konnte deine Projekt-Tabs nicht koordinieren. Lade die Seite in einem aktuellen Browser über HTTPS neu.","session.restoreTitle":"Projekt kann nicht wiederhergestellt werden","session.restoreMessage":"Der Editor konnte dein gespeichertes Projekt nicht laden. Versuche, diesen Tab neu zu laden. Die Bearbeitung ist pausiert, um deine gespeicherte Arbeit zu schützen.","tool.pencil":"Stift","tool.eraser":"Radierer","tool.line":"Linie","tool.circle":"Kreis","tool.square":"Quadrat","tool.fill":"Füllen","tool.eye-dropper":"Pipette","tool.move":"Verschieben","tool.lasso":"Freihand-Lasso","selection.move":"Auswahl verschieben","selection.scale":"Auswahl skalieren","selection.rotate":"Auswahl drehen","selection.clear":"Auswahl aufheben","canvas.noLassoEmpty":"Kein Lasso auf leerem Frame. Deaktivieren, um zu zeichnen.","canvas.layerHidden":"Ebene ist ausgeblendet.","canvas.groupMoveEmpty":"Bewege den Abspielkopf zu einem Frame mit Inhalt in dieser Gruppe.","canvas.groupHidden":"Gruppe ist ausgeblendet. Blende sie und ihre übergeordneten Gruppen ein, um sie zu bearbeiten.","canvas.groupSelected":"Verwende Verschieben, um die ganze Gruppe zu bewegen. Wähle eine Ebene aus, um andere Werkzeuge zu nutzen.","canvas.groupLasso":"Wähle eine Ebene in dieser Gruppe aus, um das Lasso zu verwenden. Deaktiviere das Lasso, um die ganze Gruppe zu verschieben.","canvas.noMoveEmpty":"Kein Verschieben auf leerem Frame.","canvas.noEyeDropperEmpty":"Keine Pipette auf leerem Frame.","toolbar.smoothStabilizer":"Glättungsstabilisator","header.brushSize":"Pinselgröße","header.copy":"Kopieren","header.paste":"Einfügen","header.undo":"Rückgängig","header.redo":"Wiederholen","header.grid":"Raster","header.mirrorX":"Spiegel X","header.mirrorY":"Spiegel Y","header.pixelPerfect":"Pixelgenau (1px Stift, Spiegel aus)","header.shapeFilled":"Form gefüllt","header.fillModeConnected":"Verbunden","header.fillModeAllMatching":"Alle übereinstimmenden","header.fillModeConnectedTitle":"Nur verbundene Pixel füllen (zusammenhängend)","header.fillModeAllMatchingTitle":"Alle übereinstimmenden Pixel füllen","header.new":"Neues Projekt","header.download":"Herunterladen / Exportieren","header.resizeCanvas":"Leinwand skalieren","header.shareAnimation":"Projekt teilen","header.saveProject":"Projekt speichern","import.title":"Bild importieren","import.choose":"Auswählen…","import.crop":"Zuschneiden","import.expand":"Leinwand erweitern","import.expandLimit":"Leinwand erweitern (max. 500 px)","import.fit":"An Leinwand anpassen","import.smooth":"Weiche Skalierung","import.hidden":"Zielgruppe ist ausgeblendet.","import.loading":"Wird geladen…","import.image":"Bild","import.scale":"Skalierung","import.preview":"Vorschau des importierten Bildes","import.confirm":"Importieren","import.limit":"Die Leinwand ist auf 500 × 500 Pixel begrenzt.","import.layerLimit":"Das Projekt hat bereits 30 Ebenen. Entferne vor dem Import eine Ebene.","import.depthLimit":"Diese Gruppe ist zu tief verschachtelt. Wähle vor dem Import eine übergeordnete Gruppe.","import.unavailable":"Stoppe die Wiedergabe und importiere im aktiven Bearbeitungs-Tab.","import.formatError":"Wähle ein PNG-, JPEG-, GIF-, WebP- oder BMP-Bild.","import.fileLimit":"Wähle ein Bild kleiner als 25 MB.","import.pixelLimit":"Wähle ein Bild mit höchstens 16 Millionen Pixeln.","import.readError":"Dieses Bild konnte nicht geöffnet werden. Versuche ein anderes Bild.","import.anchor.top-left":"Oben links","import.anchor.top-center":"Oben Mitte","import.anchor.top-right":"Oben rechts","import.anchor.middle-left":"Mitte links","import.anchor.center":"Mitte","import.anchor.middle-right":"Mitte rechts","import.anchor.bottom-left":"Unten links","import.anchor.bottom-center":"Unten Mitte","import.anchor.bottom-right":"Unten rechts","header.loadProject":"Projekt öffnen","header.discord":"Discord","header.tutorials":"Tutorials","header.feedback":"Feedback","header.error.tooLarge":"Das Projekt ist zu groß zum Teilen per URL. Versuche, die Anzahl der Frames oder Ebenen oder die Leinwandgröße zu reduzieren.","header.error.noCompression":"Dein Browser unterstützt keine Komprimierung. Versuche einen modernen Browser.","header.error.shareFailed":"Fehler beim Erstellen der Freigabe-URL.","header.error.loadFailed":"Fehler beim Laden der Projektdatei.","timeline.insertFrame":"Frame einfügen","timeline.moveFrameBackward":"Frame nach hinten","timeline.moveFrameForward":"Frame nach vorne","timeline.trimFrameLength":"Frame-Länge kürzen","timeline.extendFrameLength":"Frame-Länge verlängern","timeline.deleteFrame":"Frame löschen","timeline.splitClip":"Clip teilen","timeline.onionSkin":"Zwiebelschicht","timeline.lastFrame":"Vorheriger Frame","timeline.playAnimation":"Animation abspielen","timeline.nextFrame":"Nächster Frame","timeline.currentFrame":"Aktueller Frame","timeline.framesPerSecond":"Bilder pro Sekunde","timeline.fps":"FPS","timeline.addLayer":"Ebene hinzufügen","timeline.cloneLayer":"Ebene duplizieren","timeline.moveLayerUp":"Ebene nach oben","timeline.moveLayerDown":"Ebene nach unten","timeline.deleteLayer":"Ebene löschen","color.title":"Farbe","color.hsl":"HSL","color.rgb":"RGB","color.current":"Aktuelle Farbe","color.previous":"Vorherige Farbe","color.restorePrevious":"Vorherige Farbe wiederherstellen","color.addColor":"Farbe hinzufügen","color.deleteColor":"Farbe löschen","color.newPalette":"Neue Palette","color.deletePalette":"Palette löschen","color.confirmDeletePalette":"Bist du sicher, dass du diese Palette löschen möchtest?","dialog.newCanvas":"Neue Leinwand","dialog.presets":"Voreinstellungen","dialog.width":"Breite","dialog.height":"Höhe","dialog.cancel":"Abbrechen","dialog.confirm":"Bestätigen","dialog.download":"Herunterladen","dialog.type":"Typ","dialog.gif":"GIF","dialog.frame":"Frame","dialog.spritesheet":"Spritesheet","dialog.size":"Größe","dialog.exporting":"Exportiere...","dialog.saveProject":"Projekt speichern","dialog.fileName":"Dateiname","dialog.renameLayer":"Ebene umbenennen","dialog.renameGroup":"Gruppe umbenennen","dialog.name":"Name","dialog.saving":"Speichere...","dialog.saveError":"Projekt konnte nicht gespeichert werden.","dialog.shareAnimation":"Projekt teilen","dialog.generatingLink":"Freigabelink wird erstellt...","dialog.shareInstruction":"Kopiere diese URL, um dein Projekt einschließlich ausgeblendeter Ebenen zu teilen. Jeder mit dem Link kann eine Kopie öffnen.","dialog.close":"Schließen","dialog.copyToClipboard":"In Zwischenablage kopieren","dialog.copied":"Kopiert!","dialog.resizeCanvas":"Leinwand skalieren","dialog.resizeContents":"Inhalte skalieren","dialog.anchor":"Anker","history.title":"Verlauf","dialog.versionUpgrade":"Versions-Update-Hinweis","shared.viewingMessage":"Du siehst ein geteiltes Projekt. Änderungen werden nicht gespeichert.","shared.backToProject":"Zurück zu meinem Projekt","app.leaveConfirm":"Bist du sicher, dass du die Seite verlassen möchtest?","migrate.updateAlert":"Neues SpritePaint-Update! Neue Funktionen:","migrate.lasso":"Einfaches Lasso-Werkzeug hinzugefügt","migrate.mirror":"Spiegel-Einstellung für den Stift: Horizontal und Vertikal","migrate.filledShapes":"Gefüllte Formen für Quadrat und Kreis","migrate.copyPaste":"Auswahl innerhalb eines Frames oder zwischen Frames kopieren und einfügen","migrate.canvasResize":"Leinwand in beliebiger Größe erstellen und während des Projekts skalieren","migrate.pan":"Leinwand durch Halten der Leertaste verschieben","migrate.extendTrim":"Frame-Länge verlängern und kürzen","migrate.onionSkin":"Zwiebelschicht-Länge steuern","migrate.fps":"FPS-Einstellungen bearbeiten und speichern","migrate.grid":"Raster ein- und ausschalten","migrate.palettes":"Farbpaletten speichern, bearbeiten und löschen","dialog.whatsNew":"Neuigkeiten","announce.intro":"SpritePaint wurde seit deinem letzten Besuch aktualisiert. Neue Funktionen:","announce.contact":"Fragen oder Feedback? Schreib an","feedback.title":"Feedback","feedback.body":"Hast du eine Frage, einen Fehler gefunden oder einen Feature-Wunsch? Das Feedback-Formular ist der schnellste Weg zu uns – alles, was du dort sendest, geht direkt ans Team.","feedback.openForm":"Feedback-Formular öffnen","feedback.orEmail":"Lieber per E-Mail? Schreib an","announce.clipMove":"Zeichnungen in der Zeitleiste per Drag & Drop verschieben","announce.clipTrim":"Beide Ränder einer Zeichnung in der Zeitleiste ziehen, um sie zu verlängern oder zu kürzen","announce.layerGroups":"Organisiere Ebenen in verschachtelten Gruppen. Verschiebe, skaliere und drehe ihre Zeichnungen gemeinsam oder verschiebe sie in der Zeitleiste.","announce.toolControls":"Die angezeigten Einstellungen passen sich jetzt dem ausgewählten Werkzeug an.","announce.mp4":"Lade Animationen als MP4 herunter, mit Fortschrittsanzeige und Abbruch in unterstützten Browsern.","announce.projectProtection":"Neue Hinweise bei Speicherfehlern, Wiederherstellungsoptionen und Schutz vor widersprüchlichen Änderungen in mehreren Tabs.","announce.importImage":"Füge über „Bild importieren“ im Menü ein Bild als neue Ebene hinzu. Schneide es zu, passe es an die Leinwand an oder vergrößere die Leinwand. Der Import lässt sich in einem Schritt rückgängig machen.","export.output":"Ausgabe:","export.perFrame":"pro Frame","export.padded":"Für MP4 auf gerade Abmessungen aufgefüllt.","export.tooLarge":"Diese Größe ist für deinen Browser zu groß. Wähle eine kleinere Größe.","export.frames":"Frames","export.starting":"Wird gestartet…","export.rendering":"Rendern","export.finalizing":"Wird abgeschlossen…","landing.title":"SpritePaint — Kostenloser Online-Editor für Pixel-Art & Sprites","landing.metaDescription":"Kostenloser Online-Editor für Pixel-Art und Animationen. Zeichne Sprites, animiere Bild für Bild und exportiere als Spritesheet, GIF und PNG. Kein Download nötig.","landing.ogDescription":"Kostenloser Online-Editor für Pixel-Art und Animationen. Zeichne Sprites, animiere Bild für Bild und exportiere als Spritesheet, GIF und PNG.","landing.startDrawing":"Jetzt zeichnen","landing.heroTitle":"Online-Editor für <span>Pixel-Art</span> & Sprites","landing.heroSubtitle":"Zeichne Sprites, animiere sie Bild für Bild und exportiere sie als PNG, GIF oder Spritesheet – direkt im Browser.","landing.noAccount":"Kein Konto nötig","landing.featuresHeading":"Alles, was du brauchst – nichts, was du nicht brauchst","landing.drawingTools":"Zeichenwerkzeuge","landing.drawingToolsDesc":"Stift, Radierer, Linie, Kreis, Rechteck, Fülleimer, Pipette und Lasso-Auswahl. Einstellbare Pinselgrößen von 1 bis 64 Pixel. Spiegelzeichnen entlang der X- und Y-Achse für symmetrische Sprites.","landing.animation":"Bild-für-Bild-Animation","landing.animationDesc":"Erstelle animierte Sprites mit bis zu 100 Frames. Die Zwiebelschicht zeigt vorherige und nächste Frames als Orientierung. Stelle eigene Bildraten ein und sieh dir deine Animation in Echtzeit an.","landing.layers":"Ebenen","landing.layersDesc":"Organisiere deine Arbeit in Ebenen und verschachtelten Gruppen. Ebenen duplizieren, umsortieren, umbenennen und ein- oder ausblenden. Jede Ebene hat eigene Frame-Clips für komplexe Animationen.","landing.export":"Überall exportieren","landing.exportDesc":"Exportiere deine Arbeit als PNG-Bilder, animierte GIFs, Spritesheets oder – in unterstützten Browsern – als MP4-Video. Exporte lassen sich von 1x bis 64x skalieren. Bereit für Game-Engines wie Unity, Godot oder GameMaker.","landing.palettes":"Farbpaletten","landing.palettesDesc":"Eingebaute Paletten inklusive NES-Farben sowie eigene Paletten, die du speichern und bearbeiten kannst. Farben mit RGB- oder HSL-Reglern auswählen. Pipette zum Aufnehmen jeder Farbe auf der Leinwand.","landing.guideHeading":"So zeichnest du Pixel-Art","landing.guideStep1Title":"Wähle eine kleine Leinwand.","landing.guideStep1Desc":"16x16 oder 32x32 ist eine klassische Größe für Figuren, Gegenstände und Icons.","landing.guideStep2Title":"Zeichne die Silhouette.","landing.guideStep2Desc":"Umreiße die Form mit einem 1-Pixel-Stift und einer einzigen dunklen Farbe.","landing.guideStep3Title":"Fülle die Grundfarben.","landing.guideStep3Desc":"Nutze das Füllwerkzeug und eine begrenzte Palette – für den Anfang reichen 4–8 Farben.","landing.guideStep4Title":"Setze Licht und Schatten.","landing.guideStep4Desc":"Lege eine Lichtrichtung fest: auf der Schattenseite einen dunkleren Ton, auf der beleuchteten Seite einen helleren.","landing.guideStep5Title":"Exportiere.","landing.guideStep5Desc":"Speichere ein PNG in 4x oder 8x, damit jeder Pixel scharf bleibt.","landing.guideAnimationHeading":"Pixel-Animation","landing.guideAnimationDesc":"Füge Frames hinzu, schalte die Zwiebelschicht ein und zeichne die Bewegung Schritt für Schritt. Für eine Idle-Animation reichen 2–4 Frames, ein Laufzyklus braucht meist 4–8. Etwa 8–12 Bilder pro Sekunde wirken meist natürlich. Lade die fertige Animation als GIF, Spritesheet oder MP4-Video herunter.","landing.guideSchoolsHeading":"Für Schulen und Chromebooks","landing.guideSchoolsDesc":"SpritePaint läuft vollständig im Browser und funktioniert daher auf Schulcomputern und Chromebooks – ohne Installation und ohne Konten.","landing.share":"Sofort teilen","landing.shareDesc":"Erstelle mit einem Klick einen Freigabelink für deine Animation. Kein Konto nötig. Empfänger können deine Sprite-Animation direkt im Browser ansehen und abspielen.","landing.howItWorks":"So funktioniert es","landing.step1Title":"Leinwandgröße wählen","landing.step1Desc":"Von 2x2 bis 500x500. Übliche Größen: 16x16, 32x32, 64x64.","landing.step2Title":"Sprite zeichnen","landing.step2Desc":"Verwende Stift, Formen und Füllung. Füge Ebenen für Charaktere, Hintergründe und Effekte hinzu.","landing.step3Title":"Animieren","landing.step3Desc":"Frames hinzufügen, Zwiebelschicht nutzen, Vorschau in beliebiger Geschwindigkeit.","landing.step4Title":"Exportieren & teilen","landing.step4Desc":"Als PNG, GIF oder Spritesheet herunterladen — oder per Link teilen.","landing.faqHeading":"Häufig gestellte Fragen","landing.faq1Q":"Ist SpritePaint wirklich kostenlos?","landing.faq1A":"Ja, komplett kostenlos. Keine versteckten Gebühren, keine Wasserzeichen beim Export, kein Konto erforderlich.","landing.faq2Q":"Muss ich etwas herunterladen?","landing.faq2A":"Nein. SpritePaint läuft vollständig im Browser — Chrome, Firefox, Safari und Edge auf Windows, Mac, Linux und Chromebook.","landing.faq3Q":"Welche Exportformate werden unterstützt?","landing.faq3A":"PNG-Bilder, animierte GIFs, Spritesheets und – in unterstützten Browsern – MP4-Videos. Jeder Export lässt sich von 1x bis 64x skalieren.","landing.faq4Q":"Kann ich animierte Sprites erstellen?","landing.faq4A":"Ja! Bis zu 100 Frames mit Zwiebelschicht. Export als GIF oder Spritesheet für Game-Engines wie Unity, Godot oder GameMaker.","landing.faq5Q":"Wird meine Arbeit gespeichert?","landing.faq5A":"Deine Arbeit wird automatisch im Browser gespeichert. Du kannst auch als .spritepaint-Datei speichern, um ein Backup zu erstellen oder zwischen Computern zu übertragen.","landing.faq6Q":"Welche Leinwandgrößen kann ich verwenden?","landing.faq6A":"Von 2x2 bis 500x500 Pixel. Beliebte Sprite-Größen: 8x8, 16x16, 32x32, 64x64. Die Größe lässt sich jederzeit ändern, und du entscheidest, ob deine Zeichnung an die neue Größe angepasst wird.","landing.readyToCreate":"Bereit loszulegen?","landing.joinArtists":"Schließ dich Tausenden von Pixel-Art-Künstlern an. In Sekunden mit dem Zeichnen beginnen.","landing.openApp":"SpritePaint öffnen","landing.footer":"SpritePaint — Kostenloser Online-Editor für Pixel-Art & Sprites"},fr:{"header.pencilOnly":"Dessiner uniquement avec l'Apple Pencil","header.touchDrawing":"Dessiner au doigt ou avec l'Apple Pencil","header.drawingInput":"Mode de saisie","project.recoveryTitle":"Récupérer un projet endommagé ?","project.recoveryMessage":"Le fichier contient des données endommagées. Vous pouvez ouvrir une copie récupérée avec les modifications listées ci-dessous, ou annuler pour conserver votre projet actuel. Le fichier d'origine ne sera pas modifié.","project.recover":"Ouvrir la copie récupérée","project.restoreDamaged":"Votre sauvegarde dans le navigateur contient des données endommagées. Elle n'a pas été remplacée. Téléchargez une copie récupérée pour examiner les modifications listées ci-dessous.","storage.loadTitle":"Impossible d'ouvrir le stockage du navigateur","storage.loadMessage":"Une partie de SpritePaint n'a pas pu se charger. Réessayez d'ouvrir l'éditeur. L'édition est suspendue pour protéger votre travail enregistré.","storage.saveFailed":"Les modifications ne sont pas enregistrées dans ce navigateur. Téléchargez une copie du projet avant de fermer.","storage.downloadFailed":"La copie du projet n'a pas pu être téléchargée. Gardez cet onglet ouvert et réessayez.","storage.downloadCopy":"Télécharger une copie du projet","storage.retrySave":"Réessayer l'enregistrement","storage.retryOpen":"Réessayer l'ouverture","storage.migrationTitle":"Votre projet s'est ouvert, mais n'a pas pu être enregistré","storage.migrationMessage":"Votre copie enregistrée existante n'a pas été remplacée. L'édition est suspendue. Téléchargez une copie du projet, ou libérez de l'espace de stockage du navigateur et réessayez.","session.waitTitle":"Projet ouvert dans un autre onglet","session.waitMessage":"Fermez l'autre onglet de l'éditeur pour continuer ici. Cet onglet chargera automatiquement votre dernier travail enregistré.","session.errorTitle":"Impossible d'ouvrir l'éditeur en toute sécurité","session.errorMessage":"Ce navigateur n'a pas pu coordonner les onglets de votre projet. Rechargez dans un navigateur à jour en HTTPS.","session.restoreTitle":"Impossible de restaurer votre projet","session.restoreMessage":"L'éditeur n'a pas pu charger votre projet enregistré. Essayez de recharger cet onglet. L'édition est suspendue pour protéger votre travail enregistré.","tool.pencil":"Crayon","tool.eraser":"Gomme","tool.line":"Ligne","tool.circle":"Cercle","tool.square":"Carré","tool.fill":"Remplissage","tool.eye-dropper":"Pipette","tool.move":"Déplacer","tool.lasso":"Lasso libre","selection.move":"Déplacer la sélection","selection.scale":"Redimensionner la sélection","selection.rotate":"Pivoter la sélection","selection.clear":"Désélectionner","canvas.noLassoEmpty":"Pas de lasso sur une image vide. Désactivez pour commencer à dessiner.","canvas.layerHidden":"Le calque est masqué.","canvas.groupMoveEmpty":"Déplacez la tête de lecture sur une image contenant un dessin dans ce groupe.","canvas.groupHidden":"Le groupe est masqué. Affichez-le ainsi que ses groupes parents pour le modifier.","canvas.groupSelected":"Utilisez Déplacer pour déplacer tout le groupe. Sélectionnez un calque pour utiliser les autres outils.","canvas.groupLasso":"Sélectionnez un calque de ce groupe pour utiliser le lasso. Désactivez le lasso pour déplacer tout le groupe.","canvas.noMoveEmpty":"Pas de déplacement sur une image vide.","canvas.noEyeDropperEmpty":"Pas de pipette sur une image vide.","toolbar.smoothStabilizer":"Stabilisateur lisse","header.brushSize":"Taille du pinceau","header.copy":"Copier","header.paste":"Coller","header.undo":"Annuler","header.redo":"Rétablir","header.grid":"Grille","header.mirrorX":"Miroir X","header.mirrorY":"Miroir Y","header.pixelPerfect":"Pixel parfait (crayon 1px, miroir désactivé)","header.shapeFilled":"Forme pleine","header.fillModeConnected":"Connecté","header.fillModeAllMatching":"Tous correspondants","header.fillModeConnectedTitle":"Remplir uniquement les pixels connectés (contigus)","header.fillModeAllMatchingTitle":"Remplir tous les pixels correspondants","header.new":"Nouveau projet","header.download":"Télécharger / Exporter","header.resizeCanvas":"Redimensionner le canevas","header.shareAnimation":"Partager le projet","header.saveProject":"Enregistrer le projet","import.title":"Importer une image","import.choose":"Choisir…","import.crop":"Rogner","import.expand":"Agrandir le canevas","import.expandLimit":"Agrandir le canevas (max. 500 px)","import.fit":"Ajuster au canevas","import.smooth":"Mise à l'échelle lissée","import.hidden":"Le groupe de destination est masqué.","import.loading":"Chargement…","import.image":"Image","import.scale":"Échelle","import.preview":"Aperçu de l'image importée","import.confirm":"Importer","import.limit":"La taille du canevas est limitée à 500 × 500 pixels.","import.layerLimit":"Le projet contient déjà 30 calques. Supprimez un calque avant d'importer.","import.depthLimit":"Ce groupe est trop profondément imbriqué. Sélectionnez un groupe parent avant d'importer.","import.unavailable":"Arrêtez la lecture et utilisez l'onglet d'édition actif pour importer.","import.formatError":"Choisissez une image PNG, JPEG, GIF, WebP ou BMP.","import.fileLimit":"Choisissez une image de moins de 25 Mo.","import.pixelLimit":"Choisissez une image de 16 millions de pixels au maximum.","import.readError":"Impossible d'ouvrir cette image. Essayez-en une autre.","import.anchor.top-left":"En haut à gauche","import.anchor.top-center":"En haut au centre","import.anchor.top-right":"En haut à droite","import.anchor.middle-left":"Au milieu à gauche","import.anchor.center":"Centre","import.anchor.middle-right":"Au milieu à droite","import.anchor.bottom-left":"En bas à gauche","import.anchor.bottom-center":"En bas au centre","import.anchor.bottom-right":"En bas à droite","header.loadProject":"Ouvrir un projet","header.discord":"Discord","header.tutorials":"Tutoriels","header.feedback":"Avis","header.error.tooLarge":"Le projet est trop grand pour être partagé par URL. Essayez de réduire le nombre d'images, de calques ou la taille du canevas.","header.error.noCompression":"Votre navigateur ne prend pas en charge la compression. Essayez un navigateur moderne.","header.error.shareFailed":"Échec de la génération de l'URL de partage.","header.error.loadFailed":"Échec du chargement du fichier projet.","timeline.insertFrame":"Insérer une image","timeline.moveFrameBackward":"Déplacer l'image en arrière","timeline.moveFrameForward":"Déplacer l'image en avant","timeline.trimFrameLength":"Réduire la durée de l'image","timeline.extendFrameLength":"Prolonger la durée de l'image","timeline.deleteFrame":"Supprimer l'image","timeline.splitClip":"Diviser le clip","timeline.onionSkin":"Pelure d'oignon","timeline.lastFrame":"Image précédente","timeline.playAnimation":"Lire l'animation","timeline.nextFrame":"Image suivante","timeline.currentFrame":"Image actuelle","timeline.framesPerSecond":"Images par seconde","timeline.fps":"IPS","timeline.addLayer":"Ajouter un calque","timeline.cloneLayer":"Dupliquer le calque","timeline.moveLayerUp":"Monter le calque","timeline.moveLayerDown":"Descendre le calque","timeline.deleteLayer":"Supprimer le calque","color.title":"Couleur","color.hsl":"HSL","color.rgb":"RGB","color.current":"Couleur actuelle","color.previous":"Couleur précédente","color.restorePrevious":"Restaurer la couleur précédente","color.addColor":"Ajouter une couleur","color.deleteColor":"Supprimer la couleur","color.newPalette":"Nouvelle palette","color.deletePalette":"Supprimer la palette","color.confirmDeletePalette":"Êtes-vous sûr de vouloir supprimer cette palette ?","dialog.newCanvas":"Nouveau canevas","dialog.presets":"Préréglages","dialog.width":"Largeur","dialog.height":"Hauteur","dialog.cancel":"Annuler","dialog.confirm":"Confirmer","dialog.download":"Télécharger","dialog.type":"Type","dialog.gif":"GIF","dialog.frame":"Image","dialog.spritesheet":"Feuille de sprites","dialog.size":"Taille","dialog.exporting":"Exportation...","dialog.saveProject":"Enregistrer le projet","dialog.fileName":"Nom du fichier","dialog.renameLayer":"Renommer le calque","dialog.renameGroup":"Renommer le groupe","dialog.name":"Nom","dialog.saving":"Enregistrement...","dialog.saveError":"Échec de l'enregistrement du projet.","dialog.shareAnimation":"Partager le projet","dialog.generatingLink":"Génération du lien...","dialog.shareInstruction":"Copiez cette URL pour partager votre projet, calques masqués compris. Toute personne ayant le lien peut en ouvrir une copie.","dialog.close":"Fermer","dialog.copyToClipboard":"Copier dans le presse-papiers","dialog.copied":"Copié !","dialog.resizeCanvas":"Redimensionner le canevas","dialog.resizeContents":"Redimensionner le contenu","dialog.anchor":"Ancre","history.title":"Historique","dialog.versionUpgrade":"Avis de mise à jour","shared.viewingMessage":"Vous consultez un projet partagé. Les modifications ne seront pas enregistrées.","shared.backToProject":"Retour à mon projet","app.leaveConfirm":"Êtes-vous sûr de vouloir quitter ?","migrate.updateAlert":"Nouvelle mise à jour de SpritePaint ! Nouvelles fonctionnalités :","migrate.lasso":"Outil lasso de base ajouté","migrate.mirror":"Réglage miroir pour le crayon : horizontal et vertical","migrate.filledShapes":"Formes pleines pour le carré et le cercle","migrate.copyPaste":"Copier-coller des sélections dans une image ou entre les images","migrate.canvasResize":"Créer un canevas de toute taille et le redimensionner en cours de projet","migrate.pan":"Déplacer le canevas en maintenant la barre d'espace","migrate.extendTrim":"Prolonger et réduire la durée des images","migrate.onionSkin":"Contrôler la durée de la pelure d'oignon","migrate.fps":"Modifier et sauvegarder les paramètres d'IPS","migrate.grid":"Activer et désactiver la grille","migrate.palettes":"Sauvegarder, modifier et supprimer les palettes de couleurs","dialog.whatsNew":"Nouveautés","announce.intro":"SpritePaint a été mis à jour depuis votre dernière visite. Les nouvelles fonctionnalités incluent :","announce.contact":"Des questions ou des retours ? Écrivez à","feedback.title":"Avis","feedback.body":"Une question, un bug ou une idée de fonctionnalité ? Le formulaire est le moyen le plus rapide de nous joindre : tout ce que vous envoyez arrive directement à l'équipe.","feedback.openForm":"Ouvrir le formulaire","feedback.orEmail":"Vous préférez l'e-mail ? Écrivez à","announce.clipMove":"Faites glisser les dessins le long de la timeline pour les déplacer","announce.clipTrim":"Faites glisser l'un ou l'autre bord d'un dessin dans la timeline pour l'allonger ou le raccourcir","announce.layerGroups":"Organisez les calques en groupes imbriqués. Déplacez, redimensionnez et faites pivoter leurs dessins ensemble, ou décalez-les dans la timeline.","announce.toolControls":"Les réglages affichés suivent désormais l’outil sélectionné.","announce.mp4":"Téléchargez les animations en MP4, avec suivi de la progression et annulation dans les navigateurs compatibles.","announce.projectProtection":"Nouvelles alertes en cas d’échec de sauvegarde, options de récupération et protection contre les modifications simultanées dans plusieurs onglets.","announce.importImage":"Ajoutez une image sur un nouveau calque via l’option Importer une image du menu. Recadrez-la, adaptez-la au canevas ou agrandissez le canevas. Annulez l’importation en une seule étape.","export.output":"Sortie :","export.perFrame":"par image","export.padded":"Complété à des dimensions paires pour le MP4.","export.tooLarge":"Cette taille est trop grande pour votre navigateur. Choisissez une taille plus petite.","export.frames":"images","export.starting":"Démarrage…","export.rendering":"Rendu","export.finalizing":"Finalisation…","landing.title":"SpritePaint — Éditeur de pixel art et de sprites gratuit en ligne","landing.metaDescription":"Éditeur de pixel art et outil d'animation gratuit en ligne. Dessinez des sprites, animez image par image et exportez en feuilles de sprites, GIF et PNG. Sans téléchargement.","landing.ogDescription":"Éditeur de pixel art et outil d'animation gratuit en ligne. Dessinez des sprites, animez image par image et exportez en feuilles de sprites, GIF et PNG.","landing.startDrawing":"Commencer à dessiner","landing.heroTitle":"Éditeur de <span>Pixel Art</span> et de sprites en ligne","landing.heroSubtitle":"Dessinez des sprites, animez-les image par image et exportez-les en PNG, GIF ou feuilles de sprites, directement dans votre navigateur.","landing.noAccount":"Aucun compte requis","landing.featuresHeading":"Tout ce qu'il faut, rien de superflu","landing.drawingTools":"Outils de dessin","landing.drawingToolsDesc":"Crayon, gomme, ligne, cercle, rectangle, pot de peinture, pipette et sélection lasso. Tailles de pinceau réglables de 1 à 64 pixels. Dessin en miroir sur les axes X et Y pour des sprites symétriques.","landing.animation":"Animation image par image","landing.animationDesc":"Créez des sprites animés avec jusqu'à 100 images. La pelure d'oignon affiche les images précédentes et suivantes comme guides. Définissez des cadences personnalisées et prévisualisez votre animation en temps réel.","landing.layers":"Calques","landing.layersDesc":"Organisez votre travail en calques et en groupes imbriqués. Dupliquez, réorganisez, renommez, affichez ou masquez vos calques. Chaque calque possède ses propres clips d'images pour des animations complexes.","landing.export":"Exportez partout","landing.exportDesc":"Exportez votre travail en images PNG, GIF animés, feuilles de sprites ou vidéo MP4 dans les navigateurs compatibles. Mettez vos exports à l'échelle de 1x à 64x. Prêt pour les moteurs de jeu comme Unity, Godot ou GameMaker.","landing.palettes":"Palettes de couleurs","landing.palettesDesc":"Palettes intégrées, dont les couleurs NES, ainsi que vos propres palettes à enregistrer et modifier. Choisissez les couleurs avec les curseurs RGB ou HSL. Pipette pour échantillonner n'importe quelle couleur sur votre canevas.","landing.guideHeading":"Comment dessiner en pixel art","landing.guideStep1Title":"Choisissez un petit canevas.","landing.guideStep1Desc":"16x16 ou 32x32 est une taille classique pour les personnages, les objets et les icônes.","landing.guideStep2Title":"Dessinez la silhouette.","landing.guideStep2Desc":"Tracez le contour avec un crayon de 1 pixel et une seule couleur foncée.","landing.guideStep3Title":"Posez les couleurs de base.","landing.guideStep3Desc":"Utilisez le remplissage et une palette limitée — 4 à 8 couleurs suffisent pour commencer.","landing.guideStep4Title":"Ajoutez lumière et ombre.","landing.guideStep4Desc":"Choisissez d'où vient la lumière : une teinte plus foncée côté ombre, une plus claire côté éclairé.","landing.guideStep5Title":"Exportez.","landing.guideStep5Desc":"Enregistrez un PNG en 4x ou 8x pour que chaque pixel reste net.","landing.guideAnimationHeading":"Animation en pixel art","landing.guideAnimationDesc":"Ajoutez des images, activez la pelure d'oignon et dessinez le mouvement étape par étape. Une animation d'attente ne demande que 2 à 4 images ; un cycle de marche en compte généralement 4 à 8. Autour de 8 à 12 images par seconde, le rendu paraît généralement naturel. Téléchargez l'animation terminée en GIF, en feuille de sprites ou en vidéo MP4.","landing.guideSchoolsHeading":"Pour les écoles et les Chromebooks","landing.guideSchoolsDesc":"SpritePaint fonctionne entièrement dans le navigateur : vous pouvez l'utiliser sur les ordinateurs de l'école et les Chromebooks sans rien installer et sans compte.","landing.share":"Partagez instantanément","landing.shareDesc":"Générez un lien de partage pour votre animation en un clic. Aucun compte requis. Les destinataires peuvent voir et lire votre animation de sprites directement dans le navigateur.","landing.howItWorks":"Comment ça marche","landing.step1Title":"Choisissez la taille du canevas","landing.step1Desc":"De 2x2 à 500x500. Tailles courantes : 16x16, 32x32, 64x64.","landing.step2Title":"Dessinez votre sprite","landing.step2Desc":"Utilisez le crayon, les formes et le remplissage. Ajoutez des calques pour les personnages, les arrière-plans et les effets.","landing.step3Title":"Animez","landing.step3Desc":"Ajoutez des images, utilisez la pelure d'oignon, prévisualisez à n'importe quelle vitesse.","landing.step4Title":"Exportez et partagez","landing.step4Desc":"Téléchargez en PNG, GIF ou feuille de sprites — ou partagez avec un lien.","landing.faqHeading":"Questions fréquentes","landing.faq1Q":"SpritePaint est-il vraiment gratuit ?","landing.faq1A":"Oui, entièrement gratuit. Pas de frais cachés, pas de filigrane sur les exportations, pas de compte requis.","landing.faq2Q":"Dois-je télécharger quelque chose ?","landing.faq2A":"Non. SpritePaint fonctionne entièrement dans votre navigateur — Chrome, Firefox, Safari et Edge sur Windows, Mac, Linux et Chromebook.","landing.faq3Q":"Quels formats d'exportation sont pris en charge ?","landing.faq3A":"Images PNG, GIF animés, feuilles de sprites et vidéo MP4 dans les navigateurs compatibles. Chaque export peut être mis à l'échelle de 1x à 64x.","landing.faq4Q":"Puis-je créer des sprites animés ?","landing.faq4A":"Oui ! Jusqu'à 100 images avec pelure d'oignon. Exportez en GIF ou feuille de sprites pour les moteurs comme Unity, Godot ou GameMaker.","landing.faq5Q":"Mon travail sera-t-il sauvegardé ?","landing.faq5A":"Votre travail est automatiquement sauvegardé dans le navigateur. Vous pouvez aussi l'enregistrer au format .spritepaint pour en faire une copie de sauvegarde ou le transférer d'un ordinateur à l'autre.","landing.faq6Q":"Quelles tailles de canevas puis-je utiliser ?","landing.faq6A":"De 2x2 à 500x500 pixels. Tailles de sprites courantes : 8x8, 16x16, 32x32, 64x64. Redimensionnez à tout moment et choisissez si votre dessin doit être mis à l'échelle de la nouvelle taille.","landing.readyToCreate":"Prêt à créer ?","landing.joinArtists":"Rejoignez des milliers d'artistes du pixel art. Commencez à dessiner en quelques secondes.","landing.openApp":"Ouvrir SpritePaint","landing.footer":"SpritePaint — Éditeur de pixel art et de sprites gratuit en ligne"}};var mt,gt,ht,ft,vt,yt,wt,bt,xt=function(){var e=new URLSearchParams(window.location.search).get("lang");if(e&&pt[e])return e;var t=navigator.language||navigator.userLanguage||"en";return t.startsWith("ru")?"ru":t.startsWith("es")?"es":t.startsWith("pt")?"pt-BR":t.startsWith("ja")?"ja":t.startsWith("zh")?"zh-CN":t.startsWith("ko")?"ko":t.startsWith("de")?"de":t.startsWith("fr")?"fr":"en"}(),kt=function(e){return pt[xt]&&pt[xt][e]||pt.en[e]||e},St=function(e,t){for(var a=e[t],r=t,n=t+1;r>0&&e[r-1]===a;)r--;for(;n<e.length&&e[n]===a;)n++;return{clip:a,start:r,end:n}},Ct=function(e,t,a){if(!e[t])return null;for(var r=St(e,t),n=r.clip,i=r.start,o=r.end,l=i,s=o;l>0&&0===e[l-1];)l--;for(;s<e.length&&0===e[s];)s++;var d=Math.max(l,Math.min(i+Math.round(a),s-(o-i))),c=e.slice();return c.fill(0,i,o),c.fill(n,d,d+o-i),{clips:c,delta:d-i}},Pt=function(e,t){var a=void 0===t?Math.max.apply(Math,[0].concat(e.map((function(e){return e.clips.length})))):t,r=a,n=-1;return e.forEach((function(e){return e.clips.forEach((function(e,t){e&&t<a&&(r=Math.min(r,t),n=Math.max(n,t))}))})),Array.from({length:a},(function(e,t){return t>=r&&t<=n?1:0}))},At=function(e,t,a){var r=Pt(e),n=Ct(r,t,a);if(!n)return null;var i=St(r,t),o=i.start,l=i.end;return{delta:n.delta,clips:n.clips,layers:e.map((function(e){var t=e.clips.slice();t.fill(0,o,l);for(var a=o;a<l;a++)t[a+n.delta]=e.clips[a]||0;return{id:e.id,clips:t}}))}},Et=function(){return b(Ea.layerTree,Ea.layers)},Tt=function(e){return Et()[Math.floor(e/30)]},_t=function(e){var t=new Set(y(e.children));return Ea.layers.filter((function(e){return t.has(e.id)}))},Dt=function(